<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>OddZone - Skill Gaming Platform</title>
    
    <!-- PWA & Theme Meta Tags -->
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#7c4dff">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="apple-touch-icon" href="icon.png">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="supabase-config.js"></script>
    <script type="module" src="supabaseClient.js"></script>
    <script type="module" src="matchmaking.js"></script>
    <!-- Paystack Inline Popup SDK -->
    <script src="https://js.paystack.co/v1/inline.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    colors: {
                        darkBg: '#0b0816',
                        cardBg: '#16112e',
                        cardHover: '#1f163f',
                        accentGreen: '#00E676',
                        accentBlue: '#00b0ff',
                        brandPurple: '#7c4dff',
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #0b0816;
            color: #ffffff;
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
            touch-action: manipulation;
        }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        @keyframes pulseGlow {
            0%, 100% { box-shadow: 0 0 15px rgba(124, 77, 255, 0.4); }
            50% { box-shadow: 0 0 30px rgba(0, 230, 118, 0.6); }
        }
        .glow-effect { animation: pulseGlow 3s infinite; }
        @keyframes radarSweep {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        .radar-line { animation: radarSweep 2s linear infinite; }
        #top-nav-bar { padding-top: max(0.75rem, env(safe-area-inset-top)); }
        #bottom-nav { padding-bottom: max(0.75rem, env(safe-area-inset-bottom)); }
        .game-filter-chip.active { background: #7c4dff; color: #fff; border-color: transparent; }
        #app-container { background: #090610; }
        #top-nav-bar { min-height: 68px; }
        #bottom-nav { min-height: 68px; padding-top: 0.65rem; }
        .auth-input { background: #090610; border-color: rgba(145, 110, 192, 0.25); border-radius: 14px; }
        .auth-input:focus { border-color: #00c9a7; box-shadow: 0 0 0 3px rgba(0, 201, 167, 0.1); }
        .tab-active { background: linear-gradient(100deg, #8529e8, #d92383); color: #fff; box-shadow: 0 4px 16px rgba(179, 32, 195, 0.2); }
        .app-panel { border: 1px solid rgba(151, 112, 192, 0.22); background: #100c1b; border-radius: 20px; }
        .app-row { border: 1px solid rgba(151, 112, 192, 0.2); background: #0b0813; border-radius: 15px; }
        .nav-item { min-width: 0; color: #858191; }
        .nav-item.is-active { color: #d775fa; }
        @media (min-width: 640px) {
            body { background: radial-gradient(ellipse at 50% 10%, #1c1027 0, #090610 52%); }
            #app-container { border: 1px solid rgba(255,255,255,0.08); }
        }
    </style>
</head>
<body class="flex justify-center items-center h-screen w-screen m-0 p-0 overflow-hidden">

    <!-- True Phone-Sized Container -->
    <div id="app-container" class="w-full h-full sm:max-w-[414px] sm:max-h-[860px] sm:rounded-[36px] bg-darkBg flex flex-col relative overflow-hidden shadow-2xl">
        
        <!-- Top Status / Notch Area -->
        <div id="top-nav-bar" class="bg-[#100c1b]/95 backdrop-blur-md px-5 py-3 flex justify-between items-center z-35 shrink-0 border-b border-white/5 hidden">
            <div class="flex min-w-0 items-center gap-3">
                <button onclick="switchTab('profile')" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-pink-600 to-brandPurple text-xs font-extrabold shadow-lg shadow-brandPurple/20" id="user-avatar-initial" aria-label="Open profile">OZ</button>
                <div class="min-w-0">
                    <p class="truncate text-sm font-bold">Hello, <span id="nav-greeting-name">Player_One</span></p>
                    <p class="mt-0.5 text-[10px] font-semibold text-emerald-300"><i class="fa-solid fa-circle-check mr-1"></i><span id="account-status-label">Real account</span></p>
                </div>
            </div>
            <div class="flex items-center space-x-3">
                <button onclick="switchTab('wallet')" class="flex items-center space-x-1.5 bg-[#090610] hover:bg-cardHover border border-emerald-300/20 px-3 py-2 rounded-full text-xs font-bold text-emerald-200 transition shadow-sm" aria-label="Open wallet">
                    <i class="fa-solid fa-wallet text-[10px]"></i>
                    <span id="wallet-balance">₦0</span>
                </button>
            </div>
        </div>

        <!-- Scrollable Main Content Area -->
        <div id="main-scroll-area" class="flex-1 overflow-y-auto no-scrollbar pb-24">
            
            <!-- VIEW 1: AUTHENTICATION SCREEN -->
            <div id="view-auth" class="p-6 flex min-h-full flex-col justify-center">
                <div class="text-center mb-7">
                    <div class="mx-auto mb-3 flex h-20 w-20 items-center justify-center rounded-3xl bg-gradient-to-br from-pink-600 via-brandPurple to-cyan-400 shadow-xl shadow-brandPurple/20">
                        <i class="fa-solid fa-bolt text-white text-3xl"></i>
                    </div>
                    <h1 class="text-3xl font-extrabold tracking-wide"><span class="bg-gradient-to-r from-pink-400 via-fuchsia-300 to-cyan-300 bg-clip-text text-transparent">OddZone</span></h1>
                    <p class="text-slate-400 text-sm mt-1">Your skill gaming arena</p>
                </div>

                <!-- Tabs (Login / Signup) -->
                <div class="flex bg-[#08060d] p-1 rounded-full mb-6 border border-white/10">
                    <button type="button" onclick="switchAuthTab('login')" id="tab-login-btn" class="tab-active flex-1 rounded-full py-3 text-sm font-bold transition">Login</button>
                    <button type="button" onclick="switchAuthTab('signup')" id="tab-signup-btn" class="flex-1 rounded-full py-3 text-sm font-semibold text-slate-400 transition">Sign Up</button>
                </div>
                <div class="relative flex py-2 items-center mb-5">
                    <div class="flex-grow border-t border-white/10"></div>
                    <span class="flex-shrink mx-4 text-slate-500 text-[10px] uppercase tracking-widest font-semibold">Account access</span>
                    <div class="flex-grow border-t border-white/10"></div>
                </div>

                <!-- Auth Form -->
                <form onsubmit="handleAuthSubmit(event)" class="space-y-4">
                    <div id="signup-name-field" class="hidden">
                        <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-300 mb-2">Choose username</label>
                        <input type="text" id="auth-username" minlength="3" maxlength="20" autocomplete="nickname" placeholder="Your gamer tag" class="auth-input w-full border px-4 py-3.5 text-sm text-white focus:outline-none transition">
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-300 mb-2">Email address</label>
                        <input type="email" id="auth-email" autocomplete="email" required placeholder="you@example.com" class="auth-input w-full border px-4 py-3.5 text-sm text-white focus:outline-none transition">
                    </div>
                    <div>
                        <div class="mb-2 flex items-center justify-between">
                            <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-300">Password</label>
                            <button type="button" onclick="sendPasswordReset()" class="text-xs font-semibold text-fuchsia-300 hover:underline">Forgot?</button>
                        </div>
                        <input type="password" id="auth-password" autocomplete="current-password" minlength="8" required placeholder="At least 8 characters" class="auth-input w-full border px-4 py-3.5 text-sm text-white focus:outline-none transition">
                    </div>
                    <button type="submit" id="auth-submit-btn" class="w-full rounded-2xl bg-gradient-to-r from-cyan-400 to-emerald-500 py-4 font-extrabold text-sm text-[#08110f] shadow-lg shadow-emerald-500/15 transition hover:brightness-105">
                        LOG IN TO ACCOUNT
                    </button>
                </form>
                <p id="auth-status" class="min-h-5 text-center text-xs leading-5 text-slate-400" role="status" aria-live="polite"></p>
                <div class="relative flex items-center py-5">
                    <div class="flex-grow border-t border-white/10"></div>
                    <span class="mx-3 text-[10px] font-semibold uppercase tracking-widest text-slate-500">or sign in with</span>
                    <div class="flex-grow border-t border-white/10"></div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <button type="button" onclick="signInWithGoogle()" class="flex items-center justify-center gap-2 rounded-2xl border border-white/10 bg-[#15121c] py-3 text-sm font-semibold transition hover:bg-white/10"><i class="fa-brands fa-google text-base text-red-400"></i>Google</button>
                    <button type="button" onclick="handleAppleLogin()" class="flex items-center justify-center gap-2 rounded-2xl border border-white/10 bg-[#15121c] py-3 text-sm font-semibold transition hover:bg-white/10"><i class="fa-brands fa-apple text-base"></i>iCloud</button>
                </div>
                <button type="button" onclick="continueAsGuest()" class="mt-3 w-full py-2 text-xs font-semibold text-slate-400 hover:text-white">Continue as guest</button>
                <p class="mt-8 text-center text-[10px] text-slate-500">Skill arena · 18+ only</p>
            </div>

            <!-- HOME DASHBOARD -->
            <div id="view-home" class="hidden space-y-5 p-5">
                <section class="grid grid-cols-2 gap-3" aria-label="Account balances">
                    <div class="app-panel p-4">
                        <div class="flex items-center justify-between text-[10px] font-bold uppercase tracking-wider text-emerald-300"><span>Naira balance</span><i class="fa-solid fa-money-bill-wave"></i></div>
                        <p id="wallet-home-balance" class="mt-2 text-xl font-extrabold">₦0</p>
                        <button onclick="switchTab('wallet')" class="mt-3 w-full rounded-lg bg-emerald-500/15 py-2 text-[11px] font-bold text-emerald-200">Deposit / Withdraw</button>
                    </div>
                    <div class="app-panel p-4">
                        <div class="flex items-center justify-between text-[10px] font-bold uppercase tracking-wider text-fuchsia-300"><span>Practice XP</span><i class="fa-solid fa-gem"></i></div>
                        <p id="practice-xp-balance" class="mt-2 text-xl font-extrabold">0 XP</p>
                        <button onclick="switchTab('rewards')" class="mt-3 w-full rounded-lg bg-fuchsia-500/15 py-2 text-[11px] font-bold text-fuchsia-200">View rewards</button>
                    </div>
                </section>

                <section class="overflow-hidden rounded-[22px] border border-fuchsia-300/20 bg-gradient-to-r from-[#21113d] via-[#35113c] to-[#102b37] p-5">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-fuchsia-200">Welcome to the arena</p>
                    <h2 class="mt-2 text-xl font-extrabold">Hey, <span id="greeting-username">Player_One</span></h2>
                    <p class="mt-1 text-xs leading-5 text-slate-300">Practice, sharpen your score, and compete in 1v1 stake challenges.</p>
                    <p class="mt-3 border-t border-white/10 pt-3 text-[10px] leading-4 text-slate-400">Compete in 1v1 stake battles or hone your skills in 2-minute practice matches.</p>
                </section>

                <!-- Active 1v1 Challenges -->
                <section class="space-y-3" aria-labelledby="active-challenges-title">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2 text-amber-300"><i class="fa-solid fa-bolt text-xs"></i><h3 id="active-challenges-title" class="text-sm font-bold">1v1 Stake Challenges</h3></div>
                        <button onclick="switchTab('games')" class="text-xs font-bold text-amber-300">New match <i class="fa-solid fa-arrow-right ml-1"></i></button>
                    </div>
                    <div id="home-active-challenges" class="space-y-2"></div>
                </section>

                <section class="grid grid-cols-2 gap-3">
                    <div class="app-panel p-4">
                        <div class="flex items-center justify-between text-[10px] font-bold uppercase tracking-wider text-cyan-200"><span>Daily practice</span><i class="fa-solid fa-bullseye"></i></div>
                        <p class="mt-2 text-sm font-bold"><span id="daily-quest-count">0</span> score trials</p>
                        <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-black/50"><div id="daily-quest-progress" class="h-full w-0 rounded-full bg-cyan-400 transition-all"></div></div>
                        <button onclick="switchTab('games')" class="mt-3 w-full rounded-lg bg-cyan-500/15 py-2 text-[11px] font-bold text-cyan-100">Play a trial</button>
                    </div>
                    <div class="app-panel p-4">
                        <div class="flex items-center justify-between text-[10px] font-bold uppercase tracking-wider text-amber-200"><span>Daily streak</span><i class="fa-solid fa-fire"></i></div>
                        <p class="mt-2 text-sm font-bold">Keep your run going</p>
                        <p class="mt-1 text-[10px] text-slate-400">Claim today's practice XP</p>
                        <button id="home-daily-claim" onclick="claimDailyReward()" class="mt-3 w-full rounded-lg bg-amber-400/15 py-2 text-[11px] font-bold text-amber-100">Claim reward</button>
                    </div>
                </section>

                <section class="space-y-3" aria-labelledby="home-games-title">
                    <div class="flex items-center justify-between">
                        <div><h3 id="home-games-title" class="text-sm font-extrabold uppercase tracking-wide">Popular games</h3><p class="mt-1 text-[10px] text-slate-400">Practice games available on this device</p></div>
                        <button onclick="switchTab('games')" class="text-xs font-bold text-fuchsia-300">See all <i class="fa-solid fa-arrow-right ml-1"></i></button>
                    </div>
                    <div id="home-popular-games" class="grid grid-cols-2 gap-3"></div>
                </section>

                <!-- Live Global Scores (All Players) -->
                <section class="space-y-3" aria-labelledby="remote-scores-title">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2 text-cyan-300">
                            <i class="fa-solid fa-globe text-xs"></i>
                            <h3 id="remote-scores-title" class="text-sm font-bold">Live Arena Results</h3>
                        </div>
                        <span class="text-[10px] uppercase tracking-wider text-slate-500">All Players</span>
                    </div>
                    <div id="remote-score-list" class="space-y-2">
                        <p class="app-row px-4 py-3 text-xs text-slate-400">Loading recent player results...</p>
                    </div>
                </section>

                <!-- Open Challenges (Pending Bets) -->
                <section class="space-y-3" aria-labelledby="pending-bets-title">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2 text-amber-300">
                            <i class="fa-solid fa-hourglass-half text-xs"></i>
                            <h3 id="pending-bets-title" class="text-sm font-bold">Open 1v1 Challenges</h3>
                        </div>
                        <span class="text-[10px] uppercase tracking-wider text-slate-500">Available</span>
                    </div>
                    <div id="pending-bets-panel" class="space-y-2">
                        <p class="app-row px-4 py-3 text-xs text-slate-400">No open challenges right now.</p>
                    </div>
                </section>

                <section class="space-y-3" aria-labelledby="recent-scores-title">
                    <div class="flex items-center justify-between"><h3 id="recent-scores-title" class="text-sm font-bold">Recent score trials</h3><span class="text-[10px] uppercase tracking-wider text-slate-500">This device</span></div>
                    <div id="dashboard-score-list" class="space-y-2"><p class="app-row px-4 py-3 text-xs text-slate-400">Your completed score trials will appear here.</p></div>
                </section>
            </div>

            <!-- GAMES LIBRARY -->
            <div id="view-games" class="hidden space-y-5 p-5">
                <section class="app-panel p-4">
                    <div class="mb-4 flex items-center gap-2 text-fuchsia-200"><i class="fa-solid fa-gamepad"></i><h2 class="text-sm font-extrabold uppercase tracking-wider">All available skill games</h2></div>
                    <div class="mb-4 flex items-center justify-between">
                        <p class="text-xs text-slate-400">Choose a title to play</p>
                        <span id="lobby-game-count" class="rounded-full border border-white/10 px-2.5 py-1 text-[10px] font-semibold text-emerald-200">0</span>
                    </div>
                    <label class="mb-3 block"><span class="sr-only">Search games</span><input id="game-search" type="search" placeholder="Search games" oninput="renderGameCards()" class="auth-input w-full border px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:outline-none transition"></label>
                    <div id="game-filter-row" class="mb-4 flex gap-2 overflow-x-auto no-scrollbar" role="tablist" aria-label="Game categories">
                        <button type="button" onclick="setGameFilter('all')" data-filter="all" class="game-filter-chip active shrink-0 rounded-full border border-white/10 bg-cardBg px-3 py-1.5 text-[11px] font-bold">All</button>
                        <button type="button" onclick="setGameFilter('3d')" data-filter="3d" class="game-filter-chip shrink-0 rounded-full border border-white/10 bg-cardBg px-3 py-1.5 text-[11px] font-semibold text-slate-300">3D</button>
                        <button type="button" onclick="setGameFilter('puzzle')" data-filter="puzzle" class="game-filter-chip shrink-0 rounded-full border border-white/10 bg-cardBg px-3 py-1.5 text-[11px] font-semibold text-slate-300">Puzzle</button>
                        <button type="button" onclick="setGameFilter('arcade')" data-filter="arcade" class="game-filter-chip shrink-0 rounded-full border border-white/10 bg-cardBg px-3 py-1.5 text-[11px] font-semibold text-slate-300">Arcade</button>
                    </div>
                    <div id="games-grid" class="grid grid-cols-1 gap-3"></div>
                </section>
            </div>

            <!-- REWARDS AND SCOREBOARD -->
            <div id="view-rewards" class="hidden space-y-5 p-5">
                <section class="app-panel border-amber-300/20 p-5">
                    <h2 class="text-sm font-extrabold uppercase tracking-wider text-amber-200">Daily rewards & quests</h2>
                    <div class="app-row mt-4 flex items-center justify-between gap-3 p-3.5">
                        <div><p class="text-sm font-semibold">Daily practice bonus</p><p class="mt-1 text-[10px] text-emerald-300">+50 Practice XP · no cash value</p></div>
                        <button id="rewards-daily-claim" onclick="claimDailyReward()" class="shrink-0 rounded-xl bg-amber-400 px-4 py-2.5 text-xs font-bold text-[#211700]">Claim</button>
                    </div>
                    <div class="app-row mt-3 flex items-center justify-between gap-3 p-3.5">
                        <div><p class="text-sm font-semibold">Invite a friend</p><p class="mt-1 text-[10px] text-slate-400">Share OddZone with your people</p></div>
                        <button onclick="inviteFriend()" class="shrink-0 rounded-xl bg-emerald-500 px-4 py-2.5 text-xs font-bold text-[#07150f]">Invite</button>
                    </div>
                    <p class="mt-3 text-[10px] leading-4 text-slate-500">XP and score records are local practice progress, not withdrawable funds.</p>
                </section>
                <section class="space-y-3" aria-labelledby="local-score-leaderboard-title">
                    <div class="flex items-center justify-between"><h3 id="local-score-leaderboard-title" class="text-sm font-bold">Score leaderboard</h3><span class="text-[10px] uppercase tracking-wider text-slate-500">This device</span></div>
                    <div id="local-score-leaderboard" class="space-y-2"><p class="app-row px-4 py-3 text-xs text-slate-400">Complete a score trial to appear here.</p></div>
                </section>
            </div>

            <!-- FRIENDS -->
            <div id="view-friends" class="hidden p-5">
                <section class="app-panel border-cyan-300/20 p-5">
                    <div class="flex items-center gap-2 text-cyan-200"><i class="fa-solid fa-user-group"></i><h2 class="text-sm font-extrabold uppercase tracking-wider">Friends & 1v1 duels</h2></div>
                    <p class="mt-4 text-xs leading-5 text-slate-300">Invite a friend to try OddZone. Online friend challenges and live matchmaking are not connected yet.</p>
                    <div class="app-row mt-4 flex items-center gap-3 p-3">
                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-cyan-400/15 text-sm font-bold text-cyan-200" id="friend-initials">OZ</div>
                        <div class="min-w-0 flex-1"><p id="friend-invite-name" class="truncate text-xs font-bold">Your invite link</p><p class="mt-1 text-[10px] text-slate-400">Share it directly with a friend</p></div>
                        <button onclick="inviteFriend()" class="shrink-0 rounded-lg bg-cyan-400 px-3 py-2 text-[10px] font-bold text-[#071318]">Invite</button>
                    </div>
                    <button onclick="inviteFriend()" class="mt-4 w-full rounded-xl border border-cyan-300/20 bg-cyan-400/10 py-3 text-xs font-bold text-cyan-100"><i class="fa-solid fa-link mr-2"></i>Copy invite link</button>
                </section>
            </div>

            <!-- WALLET SCREEN -->
            <div id="view-wallet" class="hidden space-y-5 p-5">
                <h2 class="text-sm font-extrabold uppercase tracking-wider text-emerald-200">Wallet & cashier</h2>
                
                <div class="app-panel p-5">
                    <div class="app-row p-4">
                        <p class="text-[10px] text-slate-400">Available Naira balance</p>
                        <div class="mt-1 flex items-center justify-between gap-3"><h1 class="text-3xl font-extrabold text-emerald-300" id="wallet-display-large">₦0</h1><button onclick="openDepositModal()" class="rounded-xl bg-emerald-500 px-4 py-2.5 text-xs font-bold text-[#06130e]">Deposit</button></div>
                    </div>
                    <div class="app-row mt-3 flex items-center justify-between p-4"><div><p class="text-[10px] text-slate-400">Practice XP</p><p id="wallet-practice-xp" class="mt-1 text-lg font-extrabold text-fuchsia-300">0 XP</p></div><button onclick="switchTab('rewards')" class="rounded-xl bg-fuchsia-500/15 px-4 py-2.5 text-xs font-bold text-fuchsia-200">Rewards</button></div>
                    <button onclick="openWithdrawModal()" class="mt-3 w-full rounded-xl border border-white/10 bg-white/5 py-3 text-xs font-bold text-white transition hover:bg-white/10">Withdraw funds</button>
                    <p class="mt-3 text-[10px] leading-4 text-slate-400">Instant deposits via Paystack. Minimum withdrawal: ₦1,000 to any Nigerian bank. Practice XP is strictly local practice progress.</p>
                </div>

                <div class="space-y-3">
                    <h4 class="font-bold text-sm">Recent Transactions</h4>
                    <div id="wallet-transaction-list" class="space-y-3"></div>
                </div>

                <div class="space-y-3 hidden" id="withdrawal-history-panel">
                    <h4 class="font-bold text-sm">Withdrawal Status</h4>
                    <div id="withdrawal-history-list" class="space-y-3"></div>
                </div>
            </div>

            <!-- VIEW 5: PROFILE SCREEN -->
            <div id="view-profile" class="p-6 space-y-6 hidden">
                <h3 class="text-lg font-bold">Gamer Profile</h3>
                <div class="bg-cardBg p-6 rounded-3xl border border-white/10 text-center space-y-3">
                    <div class="w-20 h-20 rounded-full bg-gradient-to-br from-brandPurple to-accentBlue mx-auto flex items-center justify-center text-2xl font-bold shadow-lg" id="profile-initial">
                        OZ
                    </div>
                    <h4 class="font-bold text-base" id="profile-name">Player_One</h4>
                    <p class="text-xs text-slate-400" id="profile-email">player@oddzone.ng</p>
                    <div class="pt-3 border-t border-white/10 flex justify-around">
                        <div>
                            <span class="block font-bold text-base text-accentGreen" id="profile-trials">0</span>
                            <span class="text-[10px] text-slate-400">Score trials</span>
                        </div>
                        <div>
                            <span class="block font-bold text-base text-white" id="profile-best">0 pts</span>
                            <span class="text-[10px] text-slate-400">Best score</span>
                        </div>
                    </div>
                </div>

                <!-- KYC Status Box -->
                <div id="profile-kyc-card" class="bg-cardBg p-4 rounded-2xl border border-white/10 space-y-2.5 text-left">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <i id="profile-kyc-icon" class="fa-solid fa-triangle-exclamation text-amber-400"></i>
                            <span id="profile-kyc-title" class="text-xs font-bold">Identity Verification (KYC)</span>
                        </div>
                        <span id="profile-kyc-badge" class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-amber-400/15 text-amber-300">Unverified</span>
                    </div>
                    <p id="profile-kyc-desc" class="text-[11px] text-slate-400 leading-4">Verify your BVN or NIN (11 digits) to unlock cash withdrawals to your Nigerian bank account.</p>
                    <button id="profile-kyc-btn" type="button" onclick="openKycModal('profile')" class="mt-1 w-full rounded-xl bg-cyan-500/15 py-2.5 text-xs font-bold text-cyan-200 hover:bg-cyan-500/25 transition">Verify BVN / NIN</button>
                </div>

                <button onclick="logoutUser()" class="w-full py-3 bg-red-500/10 hover:bg-red-500/20 text-red-500 rounded-xl font-bold text-sm border border-red-500/20 transition">Log Out</button>
            </div>

        </div>

        <!-- BOTTOM NAVIGATION BAR -->
        <div id="bottom-nav" class="absolute bottom-0 left-0 right-0 grid grid-cols-6 bg-[#100c1b]/95 backdrop-blur-md border-t border-white/10 px-3 pt-2 z-30 hidden">
            <button onclick="switchTab('home')" id="nav-home" class="nav-item flex flex-col items-center justify-center py-1 transition">
                <i class="fa-solid fa-house text-lg"></i>
                <span class="text-[10px] font-semibold mt-1">Home</span>
            </button>
            <button onclick="switchTab('games')" id="nav-games" class="nav-item flex flex-col items-center justify-center py-1 transition">
                <i class="fa-solid fa-gamepad text-lg"></i>
                <span class="text-[10px] font-semibold mt-1">Games</span>
            </button>
            <button onclick="switchTab('rewards')" id="nav-rewards" class="nav-item flex flex-col items-center justify-center py-1 transition">
                <i class="fa-solid fa-gift text-lg"></i>
                <span class="text-[10px] font-semibold mt-1">Rewards</span>
            </button>
            <button onclick="switchTab('friends')" id="nav-friends" class="nav-item flex flex-col items-center justify-center py-1 transition">
                <i class="fa-solid fa-user-group text-lg"></i>
                <span class="text-[10px] font-semibold mt-1">Friends</span>
            </button>
            <button onclick="switchTab('wallet')" id="nav-wallet" class="nav-item flex flex-col items-center justify-center py-1 transition">
                <i class="fa-solid fa-wallet text-lg"></i>
                <span class="text-[10px] font-semibold mt-1">Wallet</span>
            </button>
            <button onclick="openSettingsModal()" id="nav-settings" class="nav-item flex flex-col items-center justify-center py-1 transition">
                <i class="fa-solid fa-gear text-lg"></i>
                <span class="text-[10px] font-semibold mt-1">Settings</span>
            </button>
        </div>

        <!-- GAME MODE AND STAKE MODAL -->
        <div id="game-options-modal" class="absolute inset-0 z-50 flex items-end justify-center bg-darkBg/85 p-4 backdrop-blur-md hidden">
            <div class="w-full space-y-4 rounded-t-3xl border-t border-white/10 bg-cardBg p-5 max-h-[90vh] overflow-y-auto no-scrollbar">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-accentGreen">Select Game Mode</p>
                        <h3 id="game-options-title" class="mt-1 text-lg font-bold">Choose a game</h3>
                    </div>
                    <button onclick="closeGameOptions()" class="flex h-9 w-9 items-center justify-center rounded-full bg-white/5 text-slate-300 hover:text-white" aria-label="Close game options"><i class="fa-solid fa-xmark"></i></button>
                </div>

                <!-- CHOICE A: PRACTICE -->
                <div class="rounded-2xl border border-white/10 bg-[#0c0918] p-4 space-y-2.5">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2 text-cyan-300 font-bold text-sm">
                            <i class="fa-solid fa-graduation-cap"></i>
                            <span>A) Practice Mode</span>
                        </div>
                        <span class="rounded-full bg-cyan-400/10 px-2.5 py-0.5 text-[10px] font-bold text-cyan-300">FREE</span>
                    </div>
                    <p class="text-[11px] leading-4 text-slate-400">Play a 2-minute timed score run. Sharpen your skills and save high scores with no stake or wallet risk.</p>
                    <button type="button" onclick="playPracticeMatch()" class="w-full rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 py-3 text-xs font-bold text-white transition hover:brightness-110 flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-stopwatch"></i>
                        <span>Play 2-Min Practice Run</span>
                    </button>
                </div>

                <!-- CHOICE B: 1v1 STAKE CHALLENGE -->
                <div class="rounded-2xl border border-amber-400/30 bg-gradient-to-b from-[#1b1429] to-[#120e20] p-4 space-y-3">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2 text-amber-300 font-bold text-sm">
                            <i class="fa-solid fa-trophy"></i>
                            <span>B) 1v1 Stake Challenge</span>
                        </div>
                        <span class="rounded-full bg-amber-400/20 px-2.5 py-0.5 text-[10px] font-extrabold text-amber-300">WIN CASH</span>
                    </div>
                    <p class="text-[11px] leading-4 text-slate-300">Play a 2-minute run, submit your best score, and compete against another player. Highest score takes the pool!</p>

                    <div>
                        <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1.5">Pick your stake (₦)</label>
                        <div class="grid grid-cols-4 gap-2">
                            <button type="button" onclick="selectStakeAmount(500)" data-stake="500" class="stake-btn rounded-xl border border-white/10 bg-darkBg py-2 text-xs font-bold transition hover:border-amber-400">₦500</button>
                            <button type="button" onclick="selectStakeAmount(1000)" data-stake="1000" class="stake-btn active rounded-xl border border-amber-400 bg-amber-400/20 py-2 text-xs font-bold text-amber-200 transition">₦1,000</button>
                            <button type="button" onclick="selectStakeAmount(2000)" data-stake="2000" class="stake-btn rounded-xl border border-white/10 bg-darkBg py-2 text-xs font-bold transition hover:border-amber-400">₦2,000</button>
                            <button type="button" onclick="selectStakeAmount(5000)" data-stake="5000" class="stake-btn rounded-xl border border-white/10 bg-darkBg py-2 text-xs font-bold transition hover:border-amber-400">₦5,000</button>
                        </div>
                        <div class="mt-2 flex items-center gap-2">
                            <span class="text-[10px] text-slate-400">Custom: ₦</span>
                            <input type="number" id="custom-stake-input" min="200" step="100" value="1000" oninput="onCustomStakeChange(this.value)" class="auth-input flex-1 border px-3 py-1.5 text-xs text-white">
                        </div>
                    </div>

                    <!-- Stake & Payout Breakdown -->
                    <div class="rounded-xl border border-white/5 bg-black/40 p-3 flex items-center justify-between text-xs">
                        <div>
                            <span class="text-[10px] text-slate-400 block">Your Stake</span>
                            <span id="stake-display-amount" class="font-extrabold text-white">₦1,000</span>
                        </div>
                        <div class="text-right">
                            <span class="text-[10px] text-slate-400 block">Winner Receives (10% Rake)</span>
                            <span id="stake-payout-amount" class="font-extrabold text-accentGreen text-sm">₦1,800</span>
                        </div>
                    </div>

                    <button type="button" onclick="startStakeChallenge()" class="w-full rounded-xl bg-gradient-to-r from-amber-400 via-orange-500 to-pink-500 py-3.5 text-xs font-extrabold text-[#1a0e00] shadow-lg shadow-orange-500/20 transition hover:brightness-110 flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-bolt"></i>
                        <span>START 1v1 CHALLENGE (₦<span id="stake-btn-amount">1,000</span>)</span>
                    </button>
                    <p id="stake-error-status" class="min-h-4 text-center text-[11px] leading-4 text-rose-300"></p>
                </div>
            </div>
        </div>

        <!-- MATCHMAKING RADAR & RESULT MODAL -->
        <div id="matchmaking-modal" class="absolute inset-0 bg-darkBg/95 backdrop-blur-md z-50 flex flex-col items-center justify-center p-6 hidden">
            <!-- Animated Radar / Icon -->
            <div id="matchmaking-anim-container" class="relative w-36 h-36 mb-5 flex items-center justify-center">
                <div id="matchmaking-pulse" class="absolute inset-0 rounded-full border-2 border-brandPurple/40 animate-ping"></div>
                <div class="absolute inset-3 rounded-full border border-accentGreen/40"></div>
                <div id="matchmaking-radar" class="absolute inset-0 rounded-full border-t-2 border-accentGreen radar-line"></div>
                <div id="matchmaking-center-icon" class="w-16 h-16 rounded-2xl bg-cardBg border border-white/10 flex items-center justify-center shadow-xl">
                    <i id="matchmaking-icon" class="fa-solid fa-bolt text-accentGreen text-2xl"></i>
                </div>
            </div>

            <div class="text-center max-w-xs space-y-2 mb-6">
                <h3 class="font-extrabold text-xl" id="matchmaking-status-title">Searching for Opponent...</h3>
                <p class="text-xs text-slate-300 leading-5" id="matchmaking-status-sub">Looking for a player who completed the challenge...</p>
                <div id="matchmaking-score-breakdown" class="hidden rounded-2xl border border-white/10 bg-cardBg p-4 space-y-3 mt-3">
                    <div class="grid grid-cols-2 gap-3 text-center">
                        <div class="rounded-xl bg-black/40 p-2.5">
                            <span class="text-[10px] uppercase tracking-wider text-slate-400 block font-bold">You</span>
                            <span id="match-score-you" class="text-lg font-mono font-extrabold text-accentGreen">0</span>
                        </div>
                        <div class="rounded-xl bg-black/40 p-2.5">
                            <span id="match-opponent-label" class="text-[10px] uppercase tracking-wider text-slate-400 block font-bold truncate">Opponent</span>
                            <span id="match-score-opponent" class="text-lg font-mono font-extrabold text-amber-300">0</span>
                        </div>
                    </div>
                    <p id="match-payout-banner" class="text-xs font-bold text-accentGreen"></p>
                </div>
            </div>

            <div id="matchmaking-actions" class="flex flex-col gap-2.5 w-full max-w-xs">
                <button type="button" id="matchmaking-cancel-btn" onclick="cancelActiveChallenge()" class="w-full py-3 bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 rounded-xl text-xs font-bold transition">Cancel Search</button>
                <button type="button" id="matchmaking-play-more-btn" onclick="closeMatchmakingAndGoGames()" class="w-full py-3.5 bg-gradient-to-r from-fuchsia-500 to-purple-600 text-white rounded-xl text-xs font-extrabold transition hover:brightness-110 hidden flex items-center justify-center gap-2"><i class="fa-solid fa-gamepad"></i> Play More Games</button>
                <button type="button" id="matchmaking-done-btn" onclick="closeMatchmakingModal()" class="w-full py-3 bg-white/10 hover:bg-white/15 text-white rounded-xl text-xs font-bold transition hidden">Back to Lobby</button>
            </div>
        </div>

        <!-- GAME ARENA IFRAME MODAL -->
        <div id="game-arena-modal" class="absolute inset-0 bg-darkBg z-50 flex flex-col hidden">
            <div class="bg-cardBg px-4 py-3 border-b border-white/10 flex justify-between items-center shrink-0">
                <div class="flex items-center space-x-2">
                    <span id="arena-game-title" class="font-bold text-sm">Game Title</span>
                    <span id="arena-mode-badge" class="text-[10px] bg-accentGreen/10 text-accentGreen px-2 py-0.5 rounded font-bold">1v1 Battle</span>
                </div>
                <button onclick="closeGameArena()" class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-slate-300 hover:bg-white/10">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div id="external-game-container" class="flex-1 bg-black relative">
                <iframe id="game-iframe" src="" allow="autoplay; fullscreen; gamepad" class="w-full h-full border-0"></iframe>
                <iframe id="oddzone-game-frame" src="" title="OddZone game module" allow="autoplay; fullscreen; gamepad" class="hidden w-full h-full border-0"></iframe>
                <div id="game-scoreboard" class="pointer-events-none absolute inset-x-0 top-0 z-10 hidden bg-darkBg/90 px-4 py-3 backdrop-blur-md">
                    <div class="flex items-center justify-between gap-3">
                        <div class="min-w-0">
                            <p class="truncate text-[10px] font-bold uppercase tracking-wider text-slate-400">OddZone · <span id="scoreboard-mode">Practice</span></p>
                            <p class="mt-0.5 truncate text-xs font-semibold" id="scoreboard-player">Player_One</p>
                        </div>
                        <div class="text-center">
                            <p class="text-[9px] font-bold uppercase tracking-wider text-slate-400">Time</p>
                            <p id="match-timer" class="font-mono text-lg font-extrabold tabular-nums text-accentGreen">02:00</p>
                        </div>
                        <div class="text-right">
                            <p class="text-[9px] font-bold uppercase tracking-wider text-slate-400">Score</p>
                            <p id="match-score" class="font-mono text-lg font-extrabold tabular-nums">0</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- DEPOSIT MODAL -->
        <div id="deposit-modal" class="absolute inset-0 bg-darkBg/80 backdrop-blur-md z-50 flex items-end justify-center hidden">
            <div class="bg-cardBg w-full p-6 rounded-t-[32px] border-t border-white/10 space-y-4">
                <div class="flex justify-between items-center">
                    <h3 class="font-bold text-base">Deposit Naira (₦)</h3>
                    <button type="button" onclick="closeDepositModal()" class="text-slate-400 hover:text-white" aria-label="Close deposit modal"><i class="fa-solid fa-xmark text-lg"></i></button>
                </div>
                <p class="text-xs leading-5 text-slate-400">Instant deposits via Paystack (Debit card, Bank Transfer, USSD). Funds credit directly to your wallet upon verification.</p>
                <div class="grid grid-cols-3 gap-3">
                    <button type="button" onclick="setDepositAmount(1000)" data-amount="1000" class="deposit-amount-btn rounded-xl border border-accentGreen bg-accentGreen/15 text-accentGreen py-3 text-sm font-bold transition hover:border-accentGreen hover:text-accentGreen">₦1,000</button>
                    <button type="button" onclick="setDepositAmount(5000)" data-amount="5000" class="deposit-amount-btn rounded-xl border border-white/10 bg-darkBg py-3 text-sm font-bold transition hover:border-accentGreen hover:text-accentGreen">₦5,000</button>
                    <button type="button" onclick="setDepositAmount(10000)" data-amount="10000" class="deposit-amount-btn rounded-xl border border-white/10 bg-darkBg py-3 text-sm font-bold transition hover:border-accentGreen hover:text-accentGreen">₦10,000</button>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">Custom Amount (₦)</label>
                    <input type="number" id="custom-deposit-input" min="100" step="100" value="1000" oninput="onCustomDepositChange(this.value)" class="w-full bg-darkBg border border-white/15 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-accentGreen transition">
                </div>
                <button type="button" id="btn-paystack-deposit" onclick="processPaystackDeposit()" class="w-full rounded-xl bg-gradient-to-r from-emerald-400 to-cyan-400 py-3.5 text-sm font-extrabold text-[#08130e] shadow-lg shadow-emerald-500/20 transition hover:brightness-105 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-lock text-xs"></i>
                    <span id="deposit-pay-label">Pay ₦1,000 via Paystack</span>
                </button>
                <p id="deposit-status-msg" class="min-h-4 text-center text-xs text-rose-300"></p>
            </div>
        </div>

        <!-- WITHDRAW MODAL -->
        <div id="withdraw-modal" class="absolute inset-0 bg-darkBg/80 backdrop-blur-md z-50 flex items-end justify-center hidden">
            <div class="bg-cardBg w-full p-6 rounded-t-[32px] border-t border-white/10 space-y-4">
                <div class="flex justify-between items-center">
                    <h3 class="font-bold text-base">Withdraw Funds</h3>
                    <button type="button" onclick="closeWithdrawModal()" class="text-slate-400 hover:text-white" aria-label="Close withdrawal modal"><i class="fa-solid fa-xmark text-lg"></i></button>
                </div>
                <p class="text-xs leading-5 text-slate-400">Withdrawals are sent directly to your Nigerian bank account. Minimum: ₦1,000.</p>
                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">Bank Name</label>
                    <select id="withdraw-bank" onchange="resolveWithdrawAccountName()" class="w-full bg-darkBg border border-white/15 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-accentGreen transition">
                        <option value="058|Guaranty Trust Bank (GTB)">Guaranty Trust Bank (GTB)</option>
                        <option value="044|Access Bank">Access Bank</option>
                        <option value="057|Zenith Bank">Zenith Bank</option>
                        <option value="011|First Bank of Nigeria">First Bank of Nigeria</option>
                        <option value="033|United Bank for Africa (UBA)">United Bank for Africa (UBA)</option>
                        <option value="50211|Kuda Bank">Kuda Bank</option>
                        <option value="999992|OPay">OPay</option>
                        <option value="999991|PalmPay">PalmPay</option>
                        <option value="50515|Moniepoint MFB">Moniepoint MFB</option>
                        <option value="221|Stanbic IBTC Bank">Stanbic IBTC Bank</option>
                        <option value="070|Fidelity Bank">Fidelity Bank</option>
                        <option value="035|Wema Bank (ALAT)">Wema Bank (ALAT)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">Account Number (10 Digits)</label>
                    <input id="withdraw-account" type="text" maxlength="10" inputmode="numeric" oninput="resolveWithdrawAccountName()" placeholder="e.g. 0123456789" class="w-full bg-darkBg border border-white/15 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-accentGreen transition font-mono">
                    
                    <!-- Recipient Confirmation Card -->
                    <div id="withdraw-account-card" class="hidden mt-2.5 p-3 rounded-xl border border-emerald-400/30 bg-emerald-500/10 space-y-1 transition-all">
                        <div class="flex items-center gap-1.5 text-[10px] uppercase font-bold text-emerald-300">
                            <i class="fa-solid fa-circle-check text-xs"></i>
                            <span>Verified Recipient Name</span>
                        </div>
                        <div id="withdraw-card-acc-name" class="text-xs font-black text-white tracking-wide">ADEBAYO OKAFOR</div>
                        <div id="withdraw-card-acc-bank" class="text-[11px] font-medium text-emerald-200/80">Guaranty Trust Bank (GTB) · 0123456789</div>
                    </div>
                    <p id="withdraw-resolved-name" class="mt-1 text-[11px] font-bold min-h-4"></p>
                </div>
                <div>
                    <div class="flex justify-between items-center mb-1">
                        <label class="block text-xs font-semibold text-slate-300">Amount to Withdraw (₦)</label>
                        <span class="text-[10px] text-slate-400">Available: <span id="withdraw-max-balance">₦0</span></span>
                    </div>
                    <input id="withdraw-amount" type="number" min="1000" step="500" value="1000" class="w-full bg-darkBg border border-white/15 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-accentGreen transition">
                </div>
                <button type="button" id="btn-submit-withdrawal" onclick="submitWithdrawal()" class="w-full rounded-xl bg-gradient-to-r from-cyan-400 to-emerald-500 py-3.5 text-sm font-extrabold text-[#08130e] shadow-lg shadow-emerald-500/20 transition hover:brightness-105 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-arrow-up-from-bracket text-xs"></i>
                    <span>REQUEST WITHDRAWAL</span>
                </button>
                <p id="withdraw-status-msg" class="min-h-4 text-center text-xs text-rose-300"></p>
            </div>
        </div>

        <!-- KYC IDENTITY VERIFICATION MODAL -->
        <div id="kyc-modal" class="absolute inset-0 bg-darkBg/90 backdrop-blur-md z-50 flex items-end justify-center hidden">
            <div class="bg-cardBg w-full p-6 rounded-t-[32px] border-t border-white/10 space-y-4 max-h-[90vh] overflow-y-auto no-scrollbar">
                <div class="flex justify-between items-center">
                    <div class="flex items-center gap-2 text-cyan-300 font-bold">
                        <i class="fa-solid fa-id-card text-lg"></i>
                        <h3 class="text-base font-extrabold text-white">Identity Verification (KYC)</h3>
                    </div>
                    <button type="button" onclick="closeKycModal()" class="text-slate-400 hover:text-white" aria-label="Close KYC modal"><i class="fa-solid fa-xmark text-lg"></i></button>
                </div>

                <p id="kyc-modal-subtitle" class="text-xs leading-5 text-slate-300">
                    To comply with security standards and unlock cash withdrawals to your Nigerian bank account, please verify your BVN or NIN.
                </p>

                <!-- Verified View (if already verified) -->
                <div id="kyc-verified-view" class="hidden rounded-2xl border border-emerald-400/30 bg-emerald-500/10 p-4 space-y-2">
                    <div class="flex items-center gap-2 text-emerald-300 font-bold text-sm">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>Account Identity Verified</span>
                    </div>
                    <p id="kyc-verified-details" class="text-xs text-slate-300"></p>
                    <p class="text-[10px] text-slate-400">Withdrawals are unlocked and will be sent directly to your linked bank account.</p>
                </div>

                <!-- Form View (if unverified) -->
                <form id="kyc-form" onsubmit="handleKycSubmit(event)" class="rounded-2xl border border-white/10 bg-black/40 p-4 space-y-3">
                    <!-- ID Type Selector -->
                    <div>
                        <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1.5">1. Select ID Type</label>
                        <div class="grid grid-cols-2 gap-2">
                            <button type="button" id="kyc-type-bvn-btn" onclick="setKycType('bvn')" class="rounded-xl border border-cyan-400 bg-cyan-400/20 py-2.5 text-xs font-bold text-cyan-200 transition">BVN (Bank)</button>
                            <button type="button" id="kyc-type-nin-btn" onclick="setKycType('nin')" class="rounded-xl border border-white/10 bg-darkBg py-2.5 text-xs font-semibold text-slate-300 transition">NIN (National ID)</button>
                        </div>
                    </div>

                    <!-- 11 Digit ID Number -->
                    <div>
                        <label id="kyc-number-label" class="block text-xs font-semibold text-slate-300 mb-1">Enter 11-Digit BVN</label>
                        <input id="kyc-number-input" type="text" maxlength="11" inputmode="numeric" required placeholder="e.g. 22234567890" class="auth-input w-full border px-4 py-3 text-sm text-white font-mono focus:outline-none transition">
                        <p class="mt-1 text-[10px] text-slate-400">Must be a valid 11-digit NIBSS/NIMC registration number.</p>
                    </div>

                    <!-- Payout Bank Selection -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">2. Payout Bank for Withdrawals</label>
                        <select id="kyc-bank-select" onchange="resolveKycAccountName()" class="auth-input w-full border px-4 py-3 text-sm text-white focus:outline-none transition">
                            <option value="058|Guaranty Trust Bank (GTB)">Guaranty Trust Bank (GTB)</option>
                            <option value="044|Access Bank">Access Bank</option>
                            <option value="057|Zenith Bank">Zenith Bank</option>
                            <option value="011|First Bank of Nigeria">First Bank of Nigeria</option>
                            <option value="033|United Bank for Africa (UBA)">United Bank for Africa (UBA)</option>
                            <option value="50211|Kuda Bank">Kuda Bank</option>
                            <option value="999992|OPay">OPay</option>
                            <option value="999991|PalmPay">PalmPay</option>
                            <option value="50515|Moniepoint MFB">Moniepoint MFB</option>
                            <option value="221|Stanbic IBTC Bank">Stanbic IBTC Bank</option>
                            <option value="070|Fidelity Bank">Fidelity Bank</option>
                            <option value="035|Wema Bank (ALAT)">Wema Bank (ALAT)</option>
                        </select>
                    </div>

                    <!-- 10-Digit Bank Account -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">10-Digit NUBAN Account Number</label>
                        <input id="kyc-account-input" type="text" maxlength="10" inputmode="numeric" required placeholder="e.g. 0123456789" oninput="resolveKycAccountName()" class="auth-input w-full border px-4 py-3 text-sm text-white font-mono focus:outline-none transition">
                        
                        <!-- KYC Account Confirmation Card -->
                        <div id="kyc-account-card" class="hidden mt-2.5 p-3 rounded-xl border border-emerald-400/30 bg-emerald-500/10 space-y-1 transition-all">
                            <div class="flex items-center gap-1.5 text-[10px] uppercase font-bold text-emerald-300">
                                <i class="fa-solid fa-circle-check text-xs"></i>
                                <span>Verified Bank Account</span>
                            </div>
                            <div id="kyc-card-acc-name" class="text-xs font-black text-white tracking-wide">ADEBAYO OKAFOR</div>
                            <div id="kyc-card-acc-bank" class="text-[11px] font-medium text-emerald-200/80">Guaranty Trust Bank (GTB) · 0123456789</div>
                        </div>
                        <p id="kyc-account-resolved-name" class="mt-1 text-[11px] font-bold min-h-4"></p>
                    </div>

                    <!-- Full Legal Name -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">3. Full Legal Name (First & Last Name)</label>
                        <input id="kyc-name-input" type="text" minlength="5" required placeholder="e.g. Adebayo Emmanuel Okafor" class="auth-input w-full border px-4 py-3 text-sm text-white focus:outline-none transition">
                        <p class="mt-1 text-[10px] text-slate-400">Must match the registered name on your BVN and Bank Account.</p>
                    </div>

                    <!-- Date of Birth -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Date of Birth (18+ only)</label>
                        <input id="kyc-dob-input" type="date" required class="auth-input w-full border px-4 py-3 text-sm text-white focus:outline-none transition">
                    </div>

                    <div class="flex items-start gap-2 pt-1 text-[10px] text-slate-400">
                        <i class="fa-solid fa-shield-check text-cyan-400 mt-0.5"></i>
                        <span>Details are strictly verified against Central Bank of Nigeria (CBN) and NIBSS standards. Fake entries will be rejected.</span>
                    </div>

                    <button type="submit" id="btn-submit-kyc" class="w-full rounded-xl bg-gradient-to-r from-cyan-400 to-emerald-500 py-3.5 text-sm font-extrabold text-[#08130e] shadow-lg shadow-emerald-500/20 transition hover:brightness-105 flex items-center justify-center gap-2">
                        <i class="fa-solid fa-shield-halved text-xs"></i>
                        <span>VERIFY REAL IDENTITY</span>
                    </button>
                </form>

                <p id="kyc-status-msg" class="min-h-4 text-center text-xs text-rose-300"></p>
            </div>
        </div>

    </div>

        <!-- SETTINGS MODAL -->
        <div id="settings-modal" class="absolute inset-0 bg-darkBg/90 backdrop-blur-md z-50 flex items-end justify-center hidden">
            <div class="bg-cardBg w-full p-6 rounded-t-[32px] border-t border-white/10 space-y-5 max-h-[85vh] overflow-y-auto no-scrollbar">
                <div class="flex justify-between items-center">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-gear text-fuchsia-300 text-lg"></i>
                        <h3 class="text-base font-extrabold">Settings</h3>
                    </div>
                    <button type="button" onclick="closeSettingsModal()" class="text-slate-400 hover:text-white" aria-label="Close settings"><i class="fa-solid fa-xmark text-lg"></i></button>
                </div>

                <!-- Change Username -->
                <div class="app-row p-4 space-y-3">
                    <div class="flex items-center gap-2 text-cyan-300">
                        <i class="fa-solid fa-user-pen text-sm"></i>
                        <span class="text-sm font-bold">Change Username</span>
                    </div>
                    <p class="text-[11px] text-slate-400">Choose a new gamer tag. Must be 3–20 characters.</p>
                    <div class="flex gap-2">
                        <input id="settings-username-input" type="text" minlength="3" maxlength="20" placeholder="New username…" class="auth-input flex-1 border px-3 py-2.5 text-sm text-white focus:outline-none transition">
                        <button type="button" onclick="saveSettingsUsername()" class="shrink-0 rounded-xl bg-cyan-500 px-4 py-2.5 text-xs font-extrabold text-[#041210] transition hover:brightness-110">Save</button>
                    </div>
                    <p id="settings-username-msg" class="min-h-4 text-[11px]"></p>
                </div>

                <!-- Dark / Light Mode -->
                <div class="app-row p-4 space-y-3">
                    <div class="flex items-center gap-2 text-amber-300">
                        <i class="fa-solid fa-circle-half-stroke text-sm"></i>
                        <span class="text-sm font-bold">Appearance</span>
                    </div>
                    <p class="text-[11px] text-slate-400">Switch between Dark and Light mode.</p>
                    <div class="grid grid-cols-2 gap-2">
                        <button type="button" id="theme-dark-btn" onclick="setAppTheme('dark')" class="rounded-xl border border-fuchsia-400 bg-fuchsia-400/20 py-2.5 text-xs font-bold text-fuchsia-200 transition">
                            <i class="fa-solid fa-moon mr-1.5"></i>Dark Mode
                        </button>
                        <button type="button" id="theme-light-btn" onclick="setAppTheme('light')" class="rounded-xl border border-white/10 bg-darkBg py-2.5 text-xs font-semibold text-slate-300 transition">
                            <i class="fa-solid fa-sun mr-1.5"></i>Light Mode
                        </button>
                    </div>
                </div>

                <!-- Logout -->
                <button onclick="logoutUser()" class="w-full py-3 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-xl font-bold text-sm border border-red-500/20 transition">
                    <i class="fa-solid fa-right-from-bracket mr-2"></i>Log Out
                </button>
            </div>
        </div>

    <script>
        let currentAuthMode = 'login';
        let userWalletBalance = 0;
        let activeUser = { name: "Player_One", email: "player@oddzone.ng" };
        let supabaseAuthClient = null;
        let selectedGameId = '';
        let selectedGameTitle = '';
        let selectedGameUrl = '';
        let activeGameFilter = 'all';
        let gameLaunchToken = 0;
        let activeTimedMatch = null;
        let pendingTimedMatchMode = null;
        let matchTimerInterval = null;
        let matchFinishFallback = null;
        let activeGameScore = 0;
        let selectedStakeAmount = 1000;
        let activeStakeChallenge = null; // { id, gameId, stake, payout, status }
        const RAKE_PERCENT = 10;
        const MATCH_DURATION_MS = 120000; // 2 minutes per match
        const STORAGE_KEYS = {
            walletBalance: 'oddzone-wallet-balance',
            withdrawals: 'oddzone-withdrawals',
            transactions: 'oddzone-transactions',
            users: 'oddzone-users',
            currentUser: 'oddzone-current-user'
        };
        const GAME_CATALOG = [
            { id: 'star-shooter-3d', title: 'Star Shooter 3D', category: '3D space combat', group: '3d', icon: 'fa-jet-fighter-up', tone: 'text-cyan-200', art: 'bg-[#050614]', path: 'ODDZONE GAMES/Star Shooter 3D/index.html' },
            { id: 'pacman', title: 'Pac-Man', category: 'Maze arcade', group: 'arcade', icon: 'fa-ghost', tone: 'text-yellow-300', art: 'bg-blue-950', path: 'games/pacman/oddzone.html' },
            { id: 'pipe-hopper', title: 'Pipe Hopper', category: 'Tap arcade', group: 'arcade', icon: 'fa-feather-pointed', tone: 'text-emerald-300', art: 'bg-teal-950', path: 'games/standalone/pipe-hopper.html' },
            { id: 'breakout', title: 'Breakout', category: 'Brick breaker', group: 'arcade', icon: 'fa-table-cells', tone: 'text-orange-300', art: 'bg-orange-950', path: 'games/standalone/breakout.html' },
            { id: 'cave-runner', title: 'Cave Runner 3D', category: 'Three.js runner', group: '3d', icon: 'fa-person-running', tone: 'text-orange-200', art: 'bg-stone-900', path: 'games/cave-runner/dist/index.html' },
            { id: 'memory-match', title: 'Memory Match', category: 'Card memory', group: 'puzzle', icon: 'fa-clone', tone: 'text-pink-300', art: 'bg-rose-950', path: 'games/standalone/memory-match.html' },
            { id: 'play-snake', title: 'Play Snake', category: 'Classic snake', group: 'arcade', icon: 'fa-staff-snake', tone: 'text-lime-300', art: 'bg-green-950', url: 'https://playsnake.org/', isExternal: true },
            { id: 'flappy-bird', title: 'Flappy Bird', category: 'Tap arcade', group: 'arcade', icon: 'fa-dove', tone: 'text-yellow-200', art: 'bg-sky-950', url: 'https://flappybird.io/', isExternal: true },
            { id: 'block-blast', title: 'Block Blast', category: 'Block puzzle', group: 'puzzle', icon: 'fa-cubes', tone: 'text-fuchsia-300', art: 'bg-purple-950', url: 'https://aayanaqdas.github.io/block_blast/', isExternal: true },
            { id: 'piano-tiles', title: 'Piano Tiles', category: 'Music rhythm', group: 'arcade', icon: 'fa-music', tone: 'text-white', art: 'bg-neutral-900', url: 'https://eecheng87.github.io/piano-tiles/', isExternal: true }
        ];

        function setGameFilter(group) {
            activeGameFilter = group;
            document.querySelectorAll('.game-filter-chip').forEach(chip => {
                const isActive = chip.dataset.filter === group;
                chip.classList.toggle('active', isActive);
                chip.classList.toggle('font-bold', isActive);
                chip.classList.toggle('text-slate-300', !isActive);
            });
            renderGameCards();
        }

        function visibleGames() {
            const query = (document.getElementById('game-search')?.value || '').trim().toLowerCase();
            return GAME_CATALOG.filter(game => {
                const matchesGroup = activeGameFilter === 'all' || game.group === activeGameFilter;
                const matchesQuery = !query || `${game.title} ${game.category}`.toLowerCase().includes(query);
                return matchesGroup && matchesQuery;
            });
        }

        function renderGameCards() {
            const grid = document.getElementById('games-grid');
            const count = document.getElementById('lobby-game-count');
            const games = visibleGames();
            if (count) count.textContent = String(games.length);
            renderHomePopularGames();
            if (!grid) return;
            grid.replaceChildren();
            if (!games.length) {
                const empty = document.createElement('p');
                empty.className = 'col-span-2 rounded-xl border border-white/10 bg-cardBg px-4 py-6 text-center text-xs text-slate-400';
                empty.textContent = 'No games match that search.';
                grid.appendChild(empty);
                return;
            }
            games.forEach(game => {
                const card = document.createElement('button');
                card.type = 'button';
                card.className = 'app-row group flex items-center gap-3 p-3 text-left transition hover:border-cyan-300/50';
                card.addEventListener('click', () => openGameOptions(game.id));

                const art = document.createElement('div');
                art.className = `relative h-16 w-16 shrink-0 overflow-hidden rounded-xl ${game.art}`;
                const mark = document.createElement('div');
                mark.className = 'absolute inset-0 flex items-center justify-center';
                const icon = document.createElement('i');
                icon.className = `fa-solid ${game.icon} ${game.tone} text-2xl`;
                icon.setAttribute('aria-hidden', 'true');
                mark.append(icon);
                art.appendChild(mark);

                const details = document.createElement('div');
                details.className = 'min-w-0 flex-1';
                const title = document.createElement('p');
                title.className = 'truncate text-sm font-bold';
                title.textContent = game.title;
                const action = document.createElement('div');
                action.className = 'mt-1 flex items-center justify-between gap-2 text-[10px] text-slate-400';
                const type = document.createElement('span');
                type.textContent = game.category;
                const play = document.createElement('span');
                play.className = 'shrink-0 font-semibold text-cyan-200';
                play.innerHTML = 'Play <i class="fa-solid fa-arrow-right ml-1" aria-hidden="true"></i>';
                action.append(type, play);
                details.append(title, action);
                card.append(art, details);
                grid.appendChild(card);
            });
        }

        function renderHomePopularGames() {
            const grid = document.getElementById('home-popular-games');
            if (!grid) return;
            grid.replaceChildren();
            GAME_CATALOG.slice(0, 2).forEach(game => {
                const card = document.createElement('button');
                card.type = 'button';
                card.className = 'app-panel min-w-0 p-3 text-left transition hover:border-fuchsia-300/50';
                card.addEventListener('click', () => openGameOptions(game.id));
                const icon = document.createElement('span');
                icon.className = `mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-white/5 ${game.tone}`;
                icon.innerHTML = `<i class="fa-solid ${game.icon} text-lg" aria-hidden="true"></i>`;
                const title = document.createElement('span');
                title.className = 'block truncate text-xs font-bold';
                title.textContent = game.title;
                const type = document.createElement('span');
                type.className = 'mt-1 block truncate text-[10px] text-slate-400';
                type.textContent = game.category;
                const action = document.createElement('span');
                action.className = 'mt-2 block text-[10px] font-bold text-fuchsia-300';
                action.textContent = 'Play trial →';
                card.append(icon, title, type, action);
                grid.appendChild(card);
            });
        }

        function readPracticeScores() {
            try {
                const storedScores = JSON.parse(localStorage.getItem('oddzone-practice-scores') || '[]');
                return Array.isArray(storedScores) ? storedScores : [];
            } catch (error) {
                return [];
            }
        }

        function practiceStorageKey(suffix) {
            return `oddzone-${suffix}:${(activeUser.email || 'guest').toLowerCase()}`;
        }

        function getPracticeXp() {
            return Number(localStorage.getItem(practiceStorageKey('practice-xp'))) || 0;
        }

        function updatePracticeDashboard() {
            const today = new Date().toDateString();
            const todaysScores = readPracticeScores().filter(result =>
                (!result.playerEmail || result.playerEmail.toLowerCase() === activeUser.email.toLowerCase()) &&
                new Date(result.completedAt).toDateString() === today
            ).length;
            const count = document.getElementById('daily-quest-count');
            const progress = document.getElementById('daily-quest-progress');
            if (count) count.textContent = `${Math.min(todaysScores, 3)}/3`;
            if (progress) progress.style.width = `${Math.min(todaysScores / 3, 1) * 100}%`;
            updatePracticeRewardDisplay();
        }

        function updatePracticeRewardDisplay() {
            const xp = getPracticeXp();
            ['practice-xp-balance', 'wallet-practice-xp'].forEach(id => {
                const node = document.getElementById(id);
                if (node) node.textContent = `${xp.toLocaleString()} XP`;
            });
            const claimedToday = localStorage.getItem(practiceStorageKey('daily-claim-date')) === new Date().toDateString();
            ['home-daily-claim', 'rewards-daily-claim'].forEach(id => {
                const button = document.getElementById(id);
                if (!button) return;
                button.textContent = claimedToday ? 'Claimed today' : 'Claim reward';
                button.disabled = claimedToday;
                button.classList.toggle('opacity-50', claimedToday);
                button.classList.toggle('cursor-not-allowed', claimedToday);
            });
        }

        function claimDailyReward() {
            const key = practiceStorageKey('daily-claim-date');
            const today = new Date().toDateString();
            if (localStorage.getItem(key) === today) return;
            localStorage.setItem(key, today);
            localStorage.setItem(practiceStorageKey('practice-xp'), String(getPracticeXp() + 50));
            updatePracticeRewardDisplay();
        }

        async function inviteFriend() {
            const inviteUrl = new URL(window.location.href);
            inviteUrl.searchParams.set('invite', activeUser.name || 'player');
            const shareData = { title: 'Join me on OddZone', text: 'Try a skill game with me on OddZone.', url: inviteUrl.toString() };
            try {
                if (navigator.share) {
                    await navigator.share(shareData);
                    return;
                }
                await navigator.clipboard.writeText(shareData.url);
                alert('Invite link copied.');
            } catch (error) {
                if (error.name !== 'AbortError') window.prompt('Copy your invite link:', shareData.url);
            }
        }

        function renderLocalScores() {
            const list = document.getElementById('dashboard-score-list');
            if (!list) return;
            updatePracticeDashboard();

            const scores = readPracticeScores().filter(result =>
                !result.playerEmail || result.playerEmail.toLowerCase() === activeUser.email.toLowerCase()
            ).slice(0, 3);
            list.replaceChildren();

            if (!scores.length) {
                const emptyState = document.createElement('p');
                emptyState.className = 'rounded-xl border border-white/10 bg-cardBg px-4 py-3 text-xs text-slate-400';
                emptyState.textContent = 'Your completed score trials will appear here.';
                list.appendChild(emptyState);
                return;
            }

            scores.forEach(result => {
                const row = document.createElement('div');
                row.className = 'flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-cardBg px-4 py-3';
                const info = document.createElement('div');
                info.className = 'min-w-0';
                const gameName = document.createElement('p');
                gameName.className = 'truncate text-xs font-bold';
                gameName.textContent = result.game || 'OddZone Sky Patrol';
                const date = document.createElement('p');
                date.className = 'mt-1 text-[10px] text-slate-500';
                date.textContent = new Date(result.completedAt).toLocaleString();
                const score = document.createElement('p');
                score.className = 'shrink-0 font-mono text-sm font-extrabold text-accentGreen';
                score.textContent = `${Number(result.score || 0).toLocaleString()} pts`;
                info.append(gameName, date);
                row.append(info, score);
                list.appendChild(row);
            });
        }

        async function renderRemoteScores() {
            const list = document.getElementById('remote-score-list');
            if (!list) return;

            const client = getSupabaseAuthClient();
            if (!client) {
                list.innerHTML = '<p class="rounded-xl border border-white/10 bg-cardBg px-4 py-3 text-xs text-slate-400">Sign in to view live player results.</p>';
                return;
            }

            try {
                // Query stake_challenges or bets for recent completed games
                let { data, error } = await client
                    .from('stake_challenges')
                    .select('id, game_id, score, stake, status, created_at, user_id')
                    .not('score', 'is', null)
                    .gt('score', 0)
                    .order('created_at', { ascending: false })
                    .limit(10);

                if (error || !data || data.length === 0) {
                    const betsQuery = await client
                        .from('bets')
                        .select('id, game, game_id, score, stake, created_at, user_id')
                        .order('created_at', { ascending: false })
                        .limit(10);
                    if (!betsQuery.error && betsQuery.data && betsQuery.data.length > 0) {
                        data = betsQuery.data;
                    }
                }

                list.replaceChildren();

                if (!data || !data.length) {
                    const emptyState = document.createElement('p');
                    emptyState.className = 'rounded-xl border border-white/10 bg-cardBg px-4 py-3 text-xs text-slate-400';
                    emptyState.textContent = 'No recent scores from other players yet.';
                    list.appendChild(emptyState);
                    return;
                }

                data.forEach(result => {
                    const row = document.createElement('div');
                    row.className = 'flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-cardBg px-4 py-3';
                    const info = document.createElement('div');
                    info.className = 'min-w-0';
                    const gameTitle = result.game || (GAME_CATALOG.find(g => g.id === result.game_id)?.title) || result.game_id || 'Arcade Match';
                    const gameName = document.createElement('p');
                    gameName.className = 'truncate text-xs font-bold text-white';
                    gameName.textContent = gameTitle;
                    const date = document.createElement('p');
                    date.className = 'mt-1 text-[10px] text-slate-500';
                    date.textContent = result.created_at ? new Date(result.created_at).toLocaleString() : 'Recent';
                    const score = document.createElement('p');
                    score.className = 'shrink-0 font-mono text-sm font-extrabold text-cyan-300';
                    score.textContent = `${Number(result.score || 0).toLocaleString()} pts`;
                    info.append(gameName, date);
                    row.append(info, score);
                    list.appendChild(row);
                });
            } catch (e) {
                console.warn('Error fetching remote scores:', e);
                list.innerHTML = '<p class="rounded-xl border border-white/10 bg-cardBg px-4 py-3 text-xs text-slate-400">Unable to load remote scores right now.</p>';
            }
        }

        function renderDashboardScores() {
            renderLocalScores();
            renderRemoteScores();
            if (typeof window.loadPendingBets === 'function') {
                window.loadPendingBets();
            }
        }

        function renderLocalScoreLeaderboard() {
            const list = document.getElementById('local-score-leaderboard');
            if (!list) return;

            const scores = readPracticeScores()
                .filter(result => Number.isSafeInteger(result.score) && result.score >= 0)
                .sort((first, second) => second.score - first.score)
                .slice(0, 10);
            list.replaceChildren();

            if (!scores.length) {
                const emptyState = document.createElement('p');
                emptyState.className = 'rounded-xl border border-white/10 bg-cardBg px-4 py-3 text-xs text-slate-400';
                emptyState.textContent = 'Complete a score trial to appear here.';
                list.appendChild(emptyState);
                return;
            }

            scores.forEach((result, index) => {
                const row = document.createElement('div');
                row.className = 'flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-cardBg px-4 py-3';
                const player = document.createElement('p');
                player.className = 'min-w-0 truncate text-xs font-semibold';
                player.textContent = `${index + 1}. ${result.playerName || 'Player'}`;
                const score = document.createElement('p');
                score.className = 'shrink-0 font-mono text-sm font-extrabold text-accentGreen';
                score.textContent = `${result.score.toLocaleString()} pts`;
                row.append(player, score);
                list.appendChild(row);
            });
        }

        function getWithdrawalStatusLabel(status) {
            return status === 'Approved' ? 'Completed' : status;
        }

        function renderWalletTransactions() {
            const list = document.getElementById('wallet-transaction-list');
            if (!list) return;

            const transactions = JSON.parse(localStorage.getItem(STORAGE_KEYS.transactions) || '[]');
            if (!transactions.length) {
                list.innerHTML = `
                    <div class="bg-cardBg p-4 rounded-2xl border border-white/10">
                        <p class="font-bold text-sm">No wallet activity yet</p>
                        <p class="mt-1 text-[10px] text-slate-400">Deposits, withdrawals, and match settlements will show here.</p>
                    </div>
                `;
            } else {
                list.innerHTML = transactions.map(transaction => {
                    const isPositive = transaction.type === 'deposit' || transaction.type === 'bonus';
                    const sign = isPositive ? '+' : '-';
                    const colorClass = isPositive ? 'text-accentGreen' : 'text-rose-400';
                    const icon = transaction.type === 'withdrawal' ? 'fa-arrow-up' : 'fa-arrow-down';
                    const detail = transaction.detail || 'Just now';
                    return `
                        <div class="bg-cardBg p-4 rounded-2xl border border-white/10 flex justify-between items-center">
                            <div class="flex items-center space-x-3">
                                <div class="w-10 h-10 rounded-xl ${isPositive ? 'bg-accentGreen/10 text-accentGreen' : 'bg-rose-500/10 text-rose-400'} flex items-center justify-center">
                                    <i class="fa-solid ${icon}"></i>
                                </div>
                                <div>
                                    <p class="font-bold text-sm">${transaction.title}</p>
                                    <p class="text-[10px] text-slate-400">${detail}</p>
                                </div>
                            </div>
                            <span class="font-bold ${colorClass} text-sm">${sign}₦${Number(transaction.amount).toLocaleString()}</span>
                        </div>
                    `;
                }).join('');
            }

            const withdrawalPanel = document.getElementById('withdrawal-history-panel');
            const withdrawalList = document.getElementById('withdrawal-history-list');
            const withdrawals = JSON.parse(localStorage.getItem(STORAGE_KEYS.withdrawals) || '[]');
            if (withdrawalPanel && withdrawalList) {
                if (withdrawals.length) {
                    withdrawalPanel.classList.remove('hidden');
                    withdrawalList.innerHTML = withdrawals.map(withdrawal => {
                        const statusClass = withdrawal.status === 'Pending' ? 'text-amber-400' : withdrawal.status === 'Processing' ? 'text-blue-400' : 'text-accentGreen';
                        return `
                            <div class="bg-cardBg p-4 rounded-2xl border border-white/10">
                                <div class="flex justify-between items-center">
                                    <div>
                                        <p class="font-bold text-sm">${withdrawal.bankName}</p>
                                        <p class="text-[10px] text-slate-400">${withdrawal.accountNumber}</p>
                                    </div>
                                    <span class="text-xs font-bold ${statusClass}">${getWithdrawalStatusLabel(withdrawal.status)}</span>
                                </div>
                                <div class="mt-2 flex justify-between items-center text-xs text-slate-400">
                                    <span>₦${Number(withdrawal.amount).toLocaleString()}</span>
                                    <span>${new Date(withdrawal.time).toLocaleDateString()}</span>
                                </div>
                            </div>
                        `;
                    }).join('');
                } else {
                    withdrawalPanel.classList.add('hidden');
                }
            }
        }

        updateWalletDisplay();
        initializeSupabaseAuth();

        function setAuthStatus(message, isError = false) {
            const status = document.getElementById('auth-status');
            if (!status) return;
            status.textContent = message;
            status.classList.toggle('text-rose-300', isError);
            status.classList.toggle('text-slate-400', !isError);
        }

        function getSupabaseAuthClient() {
            if (supabaseAuthClient) return supabaseAuthClient;
            const config = window.ODDZONE_CONFIG?.supabase || window.ODDZONE_SUPABASE_CONFIG || {};
            if (!window.supabase?.createClient || !config.url || !config.anonKey) return null;
            supabaseAuthClient = window.supabase.createClient(config.url, config.anonKey, {
                auth: { autoRefreshToken: true, detectSessionInUrl: true, persistSession: true }
            });
            return supabaseAuthClient;
        }

        function showAuthenticatedApp(user, walletBalance) {
            const email = (user.email || '').toLowerCase();
            const metadata = user.user_metadata || {};
            const name = user.name || metadata.username || metadata.full_name || metadata.name || email.split('@')[0] || 'Player';
            enterApp({
                id: user.id || null,
                name,
                email,
                isGuest: Boolean(user.isGuest),
                walletBalance: walletBalance ?? user.walletBalance ?? 0,
                isVerified: Boolean(user.isVerified),
                kyc: user.kyc || null
            });
        }

        async function syncUserProfile(user) {
            const email = (user.email || '').toLowerCase();
            const metadata = user.user_metadata || {};
            const username = metadata.username || metadata.full_name || metadata.name || email.split('@')[0] || 'Player';
            let walletBalance = 0;
            let isVerified = false;
            let kyc = null;

            const client = getSupabaseAuthClient();
            if (client && user.id) {
                try {
                    const { data: profile, error } = await client
                        .from('profiles')
                        .select('*')
                        .eq('id', user.id)
                        .maybeSingle();

                    if (profile) {
                        walletBalance = Number(profile.wallet_balance || 0);
                        isVerified = Boolean(profile.is_verified);
                        if (isVerified) {
                            kyc = {
                                type: profile.kyc_type || 'bvn',
                                idMasked: profile.kyc_id_masked || '***',
                                name: profile.legal_name || username
                            };
                        }
                        showAuthenticatedApp({
                            id: user.id,
                            name: profile.username || username,
                            email,
                            isGuest: false,
                            isVerified,
                            kyc
                        }, walletBalance);
                        return;
                    } else {
                        // Create initial profile in Supabase
                        const { data: newProfile } = await client
                            .from('profiles')
                            .insert([{
                                id: user.id,
                                username: username,
                                email: email,
                                wallet_balance: 0,
                                is_verified: false
                            }])
                            .select()
                            .maybeSingle();
                        if (newProfile) {
                            walletBalance = Number(newProfile.wallet_balance || 0);
                            isVerified = Boolean(newProfile.is_verified);
                        }
                    }
                } catch (e) {
                    console.warn('Supabase profile query fallback:', e);
                }
            }

            // Fallback to local profile if offline or table not yet created
            const users = readUsers();
            const localUser = users.find(u => u.email.toLowerCase() === email);
            walletBalance = localUser?.walletBalance ?? walletBalance;
            isVerified = Boolean(localUser?.isVerified ?? isVerified);
            kyc = localUser?.kyc ?? kyc;

            showAuthenticatedApp({
                id: user.id || null,
                name: username,
                email,
                isGuest: false,
                isVerified,
                kyc
            }, walletBalance);
        }

        function enterApp(user) {
            saveCurrentUserSession(user);
            userWalletBalance = Number(user.walletBalance || 0);
            activeUser.isVerified = Boolean(user.isVerified);
            activeUser.kyc = user.kyc || null;
            document.getElementById('greeting-username').innerText = activeUser.name;
            document.getElementById('profile-name').innerText = activeUser.name;
            document.getElementById('profile-email').innerText = activeUser.email;
            const initials = (activeUser.name || 'OZ').substring(0, 2).toUpperCase();
            document.getElementById('user-avatar-initial').innerText = initials;
            document.getElementById('profile-initial').innerText = initials;
            const statusLabel = document.getElementById('account-status-label');
            if (statusLabel) {
                if (activeUser.isGuest) {
                    statusLabel.textContent = 'Guest account';
                } else if (activeUser.isVerified) {
                    statusLabel.textContent = 'Verified · Real account';
                } else {
                    statusLabel.textContent = 'Real account (Unverified)';
                }
            }
            document.getElementById('view-auth').classList.add('hidden');
            document.getElementById('top-nav-bar').classList.remove('hidden');
            document.getElementById('bottom-nav').classList.remove('hidden');
            updateWalletDisplay();
            updateKycUI();
            switchTab('home');
            renderDashboardScores();
            renderActiveChallenges();
            renderProfileStats();
            setAuthStatus('');
        }

        function showAuthScreen() {
            activeUser = { name: 'Player_One', email: 'player@oddzone.local', isGuest: true, isVerified: false, kyc: null };
            userWalletBalance = 0;
            ['home', 'games', 'rewards', 'friends', 'wallet', 'profile'].forEach(tab => {
                document.getElementById(`view-${tab}`)?.classList.add('hidden');
            });
            document.getElementById('top-nav-bar')?.classList.add('hidden');
            document.getElementById('bottom-nav')?.classList.add('hidden');
            document.getElementById('view-auth')?.classList.remove('hidden');
        }

        async function initializeSupabaseAuth() {
            const client = getSupabaseAuthClient();
            if (!client) {
                restoreLocalSession();
                return;
            }
            client.auth.onAuthStateChange(async (event, session) => {
                if (session?.user) await syncUserProfile(session.user);
                else if (event === 'SIGNED_OUT') showAuthScreen();
            });
            try {
                const { data, error } = await client.auth.getSession();
                if (error) throw error;
                setAuthStatus('');
                if (data.session?.user) await syncUserProfile(data.session.user);
                else restoreLocalSession();
            } catch (error) {
                restoreLocalSession();
                if (!localStorage.getItem(STORAGE_KEYS.currentUser)) {
                    setAuthStatus(error.message || 'Cloud accounts unavailable. Use email login on this device.', true);
                }
            }
        }

        async function handleGoogleLogin() {
            await signInWithProvider('google');
        }

        async function handleAppleLogin() {
            await signInWithProvider('apple');
        }

        async function signInWithProvider(provider) {
            const client = getSupabaseAuthClient();
            if (!client) {
                setAuthStatus('Authentication service is not configured. Please check your Supabase settings.', true);
                return;
            }
            try {
                setAuthStatus(`Connecting to ${provider === 'apple' ? 'iCloud (Apple)' : 'Google'}...`);
                const redirectUrl = (window.location.origin && window.location.origin !== 'null')
                    ? window.location.origin + window.location.pathname
                    : window.location.href.split('#')[0].split('?')[0];
                const { data, error } = await client.auth.signInWithOAuth({
                    provider,
                    options: {
                        redirectTo: redirectUrl
                    }
                });
                if (error) throw error;
            } catch (error) {
                const providerLabel = provider === 'apple' ? 'Apple (iCloud)' : 'Google';
                setAuthStatus(`Could not sign in with ${providerLabel}: ${error.message || 'Provider not enabled in Supabase'}.`, true);
            }
        }

        function saveCurrentUserSession(user) {
            activeUser = {
                id: user.id || null,
                name: user.name || (user.email ? user.email.split('@')[0] : 'Player'),
                email: (user.email || 'player@oddzone.local').toLowerCase(),
                isGuest: Boolean(user.isGuest),
                isVerified: Boolean(user.isVerified),
                kyc: user.kyc || null
            };
            localStorage.setItem(STORAGE_KEYS.currentUser, JSON.stringify(activeUser));
            const navName = document.getElementById('nav-greeting-name');
            const friendInitials = document.getElementById('friend-initials');
            const friendName = document.getElementById('friend-invite-name');
            const initials = (activeUser.name || 'OZ').substring(0, 2).toUpperCase();
            if (navName) navName.innerText = activeUser.name;
            if (friendInitials) friendInitials.innerText = initials;
            if (friendName) friendName.innerText = `${activeUser.name}'s invite link`;
        }

        function readUsers() {
            try {
                const users = JSON.parse(localStorage.getItem(STORAGE_KEYS.users) || '[]');
                return Array.isArray(users) ? users : [];
            } catch (error) {
                return [];
            }
        }

        function writeUsers(users) {
            localStorage.setItem(STORAGE_KEYS.users, JSON.stringify(users));
        }

        async function hashPassword(password) {
            const data = new TextEncoder().encode(password);
            const digest = await crypto.subtle.digest('SHA-256', data);
            return Array.from(new Uint8Array(digest)).map(byte => byte.toString(16).padStart(2, '0')).join('');
        }

        function restoreLocalSession() {
            try {
                const savedUser = JSON.parse(localStorage.getItem(STORAGE_KEYS.currentUser) || 'null');
                if (!savedUser?.email) return false;
                const foundUser = readUsers().find(user => user.email.toLowerCase() === savedUser.email.toLowerCase());
                enterApp(foundUser || savedUser);
                return true;
            } catch (error) {
                return false;
            }
        }

        function continueAsGuest() {
            const guestName = 'Guest_' + Math.floor(1000 + Math.random() * 9000);
            const guestUser = {
                name: guestName,
                email: `${guestName.toLowerCase()}@guest.oddzone.local`,
                passwordHash: '',
                walletBalance: 0,
                createdAt: new Date().toISOString(),
                updatedAt: new Date().toISOString()
            };
            const users = readUsers();
            users.push(guestUser);
            writeUsers(users);
            enterApp(guestUser);
        }

        function switchAuthTab(mode) {
            currentAuthMode = mode;
            const loginBtn = document.getElementById('tab-login-btn');
            const signupBtn = document.getElementById('tab-signup-btn');
            const nameField = document.getElementById('signup-name-field');
            const submitBtn = document.getElementById('auth-submit-btn');

            if (mode === 'login') {
                loginBtn.className = "tab-active flex-1 py-3 rounded-full text-sm font-bold transition";
                signupBtn.className = "flex-1 py-3 rounded-full text-sm font-semibold text-slate-400 transition";
                nameField.classList.add('hidden');
                submitBtn.innerText = "LOG IN TO ACCOUNT";
                submitBtn.className = 'w-full rounded-2xl bg-gradient-to-r from-cyan-400 to-emerald-500 py-4 font-extrabold text-sm text-[#08110f] shadow-lg shadow-emerald-500/15 transition hover:brightness-105';
            } else {
                signupBtn.className = "tab-active flex-1 py-3 rounded-full text-sm font-bold transition";
                loginBtn.className = "flex-1 py-3 rounded-full text-sm font-semibold text-slate-400 transition";
                nameField.classList.remove('hidden');
                submitBtn.innerText = "CREATE ACCOUNT";
                submitBtn.className = 'w-full rounded-2xl bg-gradient-to-r from-brandPurple to-pink-600 py-4 font-extrabold text-sm text-white shadow-lg shadow-brandPurple/20 transition hover:brightness-105';
            }
        }

        async function handleAuthSubmit(e) {
            e.preventDefault();
            const email = document.getElementById('auth-email').value.trim().toLowerCase();
            const password = document.getElementById('auth-password').value;
            const submitBtn = document.getElementById('auth-submit-btn');
            if (!email || !password) {
                setAuthStatus('Enter your email and password.', true);
                return;
            }
            if (password.length < 8) {
                setAuthStatus('Password must be at least 8 characters.', true);
                return;
            }

            const supabaseClient = getSupabaseAuthClient();
            if (submitBtn) submitBtn.disabled = true;
            setAuthStatus(currentAuthMode === 'signup' ? 'Creating your account…' : 'Signing you in…');

            try {
                if (supabaseClient) {
                    if (currentAuthMode === 'signup') {
                        const username = document.getElementById('auth-username').value.trim();
                        if (!username || username.length < 3) {
                            setAuthStatus('Choose a username with at least 3 characters.', true);
                            return;
                        }
                        const { data, error } = await supabaseClient.auth.signUp({
                            email,
                            password,
                            options: { data: { username } }
                        });
                        if (error) throw error;
                        if (data.session?.user) {
                            showAuthenticatedApp(data.session.user, 0);
                            return;
                        }
                        setAuthStatus('Account created. Check your email to confirm, then log in.');
                        switchAuthTab('login');
                        return;
                    }
                    const { data, error } = await supabaseClient.auth.signInWithPassword({ email, password });
                    if (error) throw error;
                    if (data.session?.user) showAuthenticatedApp(data.session.user, 0);
                    return;
                }

                const users = readUsers();
                const passwordHash = await hashPassword(password);

                if (currentAuthMode === 'signup') {
                    const username = document.getElementById('auth-username').value.trim();
                    if (!username || username.length < 3) {
                        setAuthStatus('Choose a username with at least 3 characters.', true);
                        return;
                    }
                    if (users.some(user => user.email.toLowerCase() === email)) {
                        setAuthStatus('That email already has an account. Log in instead.', true);
                        switchAuthTab('login');
                        return;
                    }
                    const newUser = {
                        name: username,
                        email,
                        passwordHash,
                        walletBalance: 0,
                        createdAt: new Date().toISOString(),
                        updatedAt: new Date().toISOString()
                    };
                    users.push(newUser);
                    writeUsers(users);
                    enterApp(newUser);
                    return;
                }

                const foundUser = users.find(user => user.email.toLowerCase() === email);
                const passwordMatches = foundUser && (
                    foundUser.passwordHash === passwordHash ||
                    foundUser.password === password
                );
                if (!foundUser || !passwordMatches) {
                    setAuthStatus('Incorrect email or password.', true);
                    return;
                }
                if (!foundUser.passwordHash) {
                    foundUser.passwordHash = passwordHash;
                    delete foundUser.password;
                    foundUser.updatedAt = new Date().toISOString();
                    writeUsers(users);
                }
                enterApp(foundUser);
            } catch (error) {
                setAuthStatus(error.message || 'Unable to complete sign-in.', true);
            } finally {
                if (submitBtn) submitBtn.disabled = false;
            }
        }

        async function sendPasswordReset() {
            const email = document.getElementById('auth-email').value.trim().toLowerCase();
            const password = document.getElementById('auth-password').value;
            if (!email) {
                setAuthStatus('Enter the email for your account first.', true);
                return;
            }
            const supabaseClient = getSupabaseAuthClient();
            if (supabaseClient) {
                try {
                    const redirectUrl = (window.location.origin && window.location.origin !== 'null') ? window.location.origin : window.location.href;
                    const { error } = await supabaseClient.auth.resetPasswordForEmail(email, {
                        redirectTo: redirectUrl
                    });
                    if (error) throw error;
                    setAuthStatus('Password reset email sent if that account exists.');
                } catch (error) {
                    setAuthStatus(error.message || 'Unable to send a reset email.', true);
                }
                return;
            }
            if (password.length < 8) {
                setAuthStatus('Type a new password of at least 8 characters, then tap Forgot again.', true);
                return;
            }
            const users = readUsers();
            const userIndex = users.findIndex(user => user.email.toLowerCase() === email);
            if (userIndex < 0) {
                setAuthStatus('No local account found for that email. Sign up instead.', true);
                return;
            }
            users[userIndex].passwordHash = await hashPassword(password);
            delete users[userIndex].password;
            users[userIndex].updatedAt = new Date().toISOString();
            writeUsers(users);
            setAuthStatus('Password updated. You can log in now.');
            switchAuthTab('login');
        }

        function switchTab(tabName) {
            const tabs = ['home', 'games', 'rewards', 'friends', 'wallet', 'profile'];
            tabs.forEach(t => {
                const view = document.getElementById(`view-${t}`);
                const nav = document.getElementById(`nav-${t}`);
                if (view) view.classList.add('hidden');
                if (nav) nav.classList.toggle('is-active', t === tabName);
            });

            const selectedView = document.getElementById(`view-${tabName}`);
            if (selectedView) selectedView.classList.remove('hidden');
            if (tabName === 'profile') renderProfileStats();
        }

        function openDepositModal() {
            document.getElementById('deposit-modal').classList.remove('hidden');
            setDepositAmount(1000);
        }
        function closeDepositModal() {
            document.getElementById('deposit-modal').classList.add('hidden');
            const msgEl = document.getElementById('deposit-status-msg');
            if (msgEl) msgEl.textContent = '';
        }
        function setDepositAmount(amount) {
            const input = document.getElementById('custom-deposit-input');
            if (input) input.value = amount;
            // Update active button state
            document.querySelectorAll('.deposit-amount-btn').forEach(btn => {
                const isActive = Number(btn.dataset.amount) === Number(amount);
                btn.classList.toggle('border-accentGreen', isActive);
                btn.classList.toggle('text-accentGreen', isActive);
                btn.classList.toggle('border-white/10', !isActive);
            });
            const label = document.getElementById('deposit-pay-label');
            if (label) label.textContent = `Pay ₦${Number(amount).toLocaleString()} via Paystack`;
        }
        function onCustomDepositChange(value) {
            const amount = Number(value) || 0;
            document.querySelectorAll('.deposit-amount-btn').forEach(btn => {
                btn.classList.remove('border-accentGreen', 'text-accentGreen');
                btn.classList.add('border-white/10');
            });
            const label = document.getElementById('deposit-pay-label');
            if (label) label.textContent = amount > 0 ? `Pay ₦${amount.toLocaleString()} via Paystack` : 'Pay via Paystack';
        }

        function processPaystackDeposit() {
            const PAYSTACK_PUBLIC_KEY = 'pk_test_2266fed5ac96b7e91b9bbef5f500be972f4992e3';
            const amountNaira = Number(document.getElementById('custom-deposit-input')?.value || 0);
            const msgEl = document.getElementById('deposit-status-msg');
            function setDepMsg(text, isErr) {
                if (msgEl) { msgEl.textContent = text; msgEl.style.color = isErr ? '#f87171' : '#86efac'; }
            }
            if (!amountNaira || amountNaira < 100) {
                setDepMsg('Minimum deposit is ₦100.', true); return;
            }
            if (activeUser.isGuest) {
                setDepMsg('Log in to deposit real money.', true); return;
            }
            if (typeof PaystackPop === 'undefined') {
                setDepMsg('Paystack is not loaded. Check your internet connection.', true); return;
            }
            const ref = 'ODZ-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8).toUpperCase();
            const handler = PaystackPop.setup({
                key: PAYSTACK_PUBLIC_KEY,
                email: activeUser.email,
                amount: Math.round(amountNaira) * 100, // kobo
                currency: 'NGN',
                ref,
                metadata: { user_id: activeUser.id || '', custom_fields: [{ display_name: 'Username', variable_name: 'username', value: activeUser.name }] },
                callback(response) {
                    setDepMsg('Payment received. Verifying on server…');
                    // Call backend to verify — until Edge Function is live, credit locally as a fallback
                    const client = getSupabaseAuthClient();
                    if (client && activeUser.id) {
                        // Record unverified deposit so server can confirm later
                        client.from('transactions').insert([{
                            user_id: activeUser.id,
                            type: 'deposit',
                            amount: amountNaira,
                            reference: response.reference,
                            status: 'pending_verify',
                            detail: `Paystack deposit ₦${amountNaira.toLocaleString()}`
                        }]).then(() => {});
                    }
                    // Optimistic local credit (server webhook / Edge Function will be the source of truth)
                    userWalletBalance += amountNaira;
                    updateWalletDisplay();
                    const transactions = JSON.parse(localStorage.getItem(STORAGE_KEYS.transactions) || '[]');
                    transactions.unshift({ title: 'Deposit via Paystack', type: 'deposit', amount: amountNaira, detail: new Date().toLocaleString(), reference: response.reference });
                    localStorage.setItem(STORAGE_KEYS.transactions, JSON.stringify(transactions.slice(0, 100)));
                    setDepMsg(`₦${amountNaira.toLocaleString()} added to your wallet!`);
                    setTimeout(() => closeDepositModal(), 2000);
                },
                onClose() {
                    setDepMsg('Payment window closed. No charge was made.', true);
                }
            });
            handler.openIframe();
        }

        function updateWalletDisplay() {
            document.getElementById('wallet-balance').innerText = `₦${userWalletBalance.toLocaleString()}`;
            document.getElementById('wallet-display-large').innerText = `₦${userWalletBalance.toLocaleString()}`;
            const homeBalance = document.getElementById('wallet-home-balance');
            if (homeBalance) homeBalance.innerText = `₦${userWalletBalance.toLocaleString()}`;
            localStorage.setItem(STORAGE_KEYS.walletBalance, String(userWalletBalance));
            if (activeUser?.email) {
                const users = readUsers();
                const userIndex = users.findIndex(user => user.email.toLowerCase() === activeUser.email.toLowerCase());
                if (userIndex >= 0) {
                    users[userIndex].walletBalance = userWalletBalance;
                    writeUsers(users);
                }
            }
            updatePracticeRewardDisplay();
            renderWalletTransactions();
        }

        let currentKycType = 'bvn';
        let kycTriggerOrigin = 'profile';

        function setKycType(type) {
            currentKycType = type;
            const bvnBtn = document.getElementById('kyc-type-bvn-btn');
            const ninBtn = document.getElementById('kyc-type-nin-btn');
            const numberLabel = document.getElementById('kyc-number-label');
            const numberInput = document.getElementById('kyc-number-input');
            const isBvn = type === 'bvn';

            if (bvnBtn) {
                bvnBtn.className = isBvn
                    ? 'rounded-xl border border-cyan-400 bg-cyan-400/20 py-2.5 text-xs font-bold text-cyan-200 transition'
                    : 'rounded-xl border border-white/10 bg-darkBg py-2.5 text-xs font-semibold text-slate-300 transition';
            }
            if (ninBtn) {
                ninBtn.className = !isBvn
                    ? 'rounded-xl border border-cyan-400 bg-cyan-400/20 py-2.5 text-xs font-bold text-cyan-200 transition'
                    : 'rounded-xl border border-white/10 bg-darkBg py-2.5 text-xs font-semibold text-slate-300 transition';
            }
            if (numberLabel) {
                numberLabel.textContent = isBvn ? 'Enter 11-Digit BVN' : 'Enter 11-Digit NIN';
            }
            if (numberInput) {
                numberInput.placeholder = isBvn ? 'e.g. 22234567890' : 'e.g. 10234567890';
                numberInput.value = '';
            }
        }

        function updateKycUI() {
            const badge = document.getElementById('profile-kyc-badge');
            const icon = document.getElementById('profile-kyc-icon');
            const desc = document.getElementById('profile-kyc-desc');
            const btn = document.getElementById('profile-kyc-btn');
            const statusLabel = document.getElementById('account-status-label');

            const isVerified = Boolean(activeUser?.isVerified);
            if (isVerified) {
                if (badge) {
                    badge.className = 'text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300';
                    badge.textContent = 'Verified ✅';
                }
                if (icon) {
                    icon.className = 'fa-solid fa-circle-check text-accentGreen';
                }
                if (desc) {
                    const idLabel = activeUser.kyc?.type ? activeUser.kyc.type.toUpperCase() : 'BVN';
                    const masked = activeUser.kyc?.idMasked || '***';
                    const legalName = activeUser.kyc?.name || activeUser.name;
                    desc.textContent = `Verified with ${idLabel} (${masked}) · ${legalName}. Instant withdrawals enabled.`;
                }
                if (btn) {
                    btn.textContent = 'View Identity Details';
                    btn.className = 'mt-1 w-full rounded-xl border border-white/10 bg-white/5 py-2.5 text-xs font-bold text-slate-300 hover:bg-white/10 transition';
                }
                if (statusLabel && !activeUser.isGuest) {
                    statusLabel.textContent = 'Verified · Real account';
                }
            } else {
                if (badge) {
                    badge.className = 'text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-amber-400/15 text-amber-300';
                    badge.textContent = 'Unverified';
                }
                if (icon) {
                    icon.className = 'fa-solid fa-triangle-exclamation text-amber-400';
                }
                if (desc) {
                    desc.textContent = 'Verify your BVN or NIN (11 digits) to unlock cash withdrawals to your Nigerian bank account.';
                }
                if (btn) {
                    btn.textContent = 'Verify BVN / NIN';
                    btn.className = 'mt-1 w-full rounded-xl bg-cyan-500/15 py-2.5 text-xs font-bold text-cyan-200 hover:bg-cyan-500/25 transition';
                }
                if (statusLabel && !activeUser.isGuest) {
                    statusLabel.textContent = 'Real account (Unverified)';
                }
            }
        }

        function openKycModal(origin = 'profile') {
            kycTriggerOrigin = origin;
            const modal = document.getElementById('kyc-modal');
            const verifiedView = document.getElementById('kyc-verified-view');
            const formView = document.getElementById('kyc-form');
            const subtitle = document.getElementById('kyc-modal-subtitle');
            const statusMsg = document.getElementById('kyc-status-msg');
            if (statusMsg) statusMsg.textContent = '';

            if (activeUser.isVerified) {
                if (verifiedView) verifiedView.classList.remove('hidden');
                if (formView) formView.classList.add('hidden');
                const det = document.getElementById('kyc-verified-details');
                if (det) {
                    const idLabel = activeUser.kyc?.type ? activeUser.kyc.type.toUpperCase() : 'BVN';
                    det.textContent = `${idLabel}: ${activeUser.kyc?.idMasked || '***'} | Name: ${activeUser.kyc?.name || activeUser.name}`;
                }
            } else {
                if (verifiedView) verifiedView.classList.add('hidden');
                if (formView) formView.classList.remove('hidden');
                if (origin === 'withdrawal' && subtitle) {
                    subtitle.textContent = '⚠️ Identity verification required: Please verify your BVN or NIN before submitting your withdrawal request.';
                } else if (subtitle) {
                    subtitle.textContent = 'To comply with security standards and unlock cash withdrawals to your Nigerian bank account, please verify your BVN or NIN.';
                }
            }
            if (modal) modal.classList.remove('hidden');
        }

        function closeKycModal() {
            document.getElementById('kyc-modal')?.classList.add('hidden');
        }

        // ── STRICT IDENTITY & CBN NUBAN VALIDATION (ZERO COST) ─────────────

        function validateCBNNuban(bankCode, accountNumber) {
            if (!/^\d{10}$/.test(accountNumber)) return false;
            const cleanBankCode = String(bankCode || '').trim();
            if (!cleanBankCode) return false;
            // Pad commercial bank codes to 3 digits (e.g. '058', '044', '011', '033', etc.)
            const code3 = cleanBankCode.padStart(3, '0').slice(-3);
            const combined = code3 + accountNumber.slice(0, 9);
            const weights = [3, 7, 3, 3, 7, 3, 3, 7, 3, 3, 7, 3];
            let sum = 0;
            for (let i = 0; i < 12; i++) {
                sum += parseInt(combined[i], 10) * weights[i];
            }
            const calculatedCheckDigit = (10 - (sum % 10)) % 10;
            const actualCheckDigit = parseInt(accountNumber[9], 10);
            return calculatedCheckDigit === actualCheckDigit;
        }

        function validateBvnOrNin(idNumber, type = 'bvn') {
            const clean = String(idNumber || '').trim();
            if (!/^\d{11}$/.test(clean)) {
                return { valid: false, error: `${type.toUpperCase()} must be exactly 11 digits.` };
            }
            // Check for repeated identical digits (e.g. 11111111111, 00000000000)
            if (/^(\d)\1{10}$/.test(clean)) {
                return { valid: false, error: `Fake ${type.toUpperCase()} rejected: Repeating numbers are invalid.` };
            }
            // Check for common ascending / descending sequences
            const sequences = [
                '01234567890', '12345678901', '23456789012', '34567890123',
                '09876543210', '98765432109', '87654321098', '76543210987'
            ];
            if (sequences.includes(clean)) {
                return { valid: false, error: `Fake ${type.toUpperCase()} rejected: Sequential numbers are invalid.` };
            }
            // Check for repetitive 2-digit or 3-digit patterns (e.g. 12121212121, 12312312312)
            if (/^(\d{2})\1{4}\d$/.test(clean) || /^(\d{3})\1{2}\d{2}$/.test(clean)) {
                return { valid: false, error: `Fake ${type.toUpperCase()} rejected: Repetitive pattern detected.` };
            }
            // Entropy / distinct digits check: Real BVNs and NINs have high entropy
            const uniqueDigits = new Set(clean.split('')).size;
            if (uniqueDigits < 4) {
                return { valid: false, error: `Fake ${type.toUpperCase()} rejected: Insufficient unique digits.` };
            }
            // Invalid NIBSS prefixes
            if (clean.startsWith('0000') || clean.startsWith('9999') || clean.startsWith('1111') || clean.startsWith('000')) {
                return { valid: false, error: `Invalid ${type.toUpperCase()}: The entered number is not a valid registered ID.` };
            }
            return { valid: true };
        }

        function validateLegalName(name) {
            const clean = String(name || '').trim().replace(/\s+/g, ' ');
            if (!clean || clean.length < 5) {
                return { valid: false, error: 'Full legal name must be at least 5 characters long.' };
            }
            const parts = clean.split(' ');
            if (parts.length < 2) {
                return { valid: false, error: 'Please enter both your First Name and Last Name (Surname).' };
            }
            // Reject gibberish / single letters
            for (const part of parts) {
                if (part.length < 2) {
                    return { valid: false, error: 'Each name part must be at least 2 letters long.' };
                }
                if (!/^[A-Za-z'-]+$/.test(part)) {
                    return { valid: false, error: 'Names must only contain letters (no numbers or symbols).' };
                }
            }
            // Block generic test/fake names
            const lower = clean.toLowerCase();
            const fakeNames = ['test user', 'test test', 'john doe', 'jane doe', 'admin user', 'fake name', 'random user', 'demo account', 'player one', 'player two', 'asdf asdf', 'qwerty keyboard', 'sample user'];
            if (fakeNames.includes(lower)) {
                return { valid: false, error: 'Please enter your real legal name as registered on your ID.' };
            }
            return { valid: true, cleanName: clean };
        }

        function validateDateOfBirth(dobString) {
            if (!dobString) {
                return { valid: false, error: 'Please select your Date of Birth.' };
            }
            const dob = new Date(dobString);
            if (isNaN(dob.getTime())) {
                return { valid: false, error: 'Invalid Date of Birth.' };
            }
            const today = new Date();
            let age = today.getFullYear() - dob.getFullYear();
            const monthDiff = today.getMonth() - dob.getMonth();
            if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) {
                age--;
            }
            if (age < 18) {
                return { valid: false, error: `You must be at least 18 years old to complete verification (Current age: ${age}).` };
            }
            if (age > 105 || dob.getFullYear() < 1920) {
                return { valid: false, error: 'Please provide a realistic Date of Birth.' };
            }
            return { valid: true, age };
        }

        let resolveKycDebounce = null;
        async function resolveKycAccountName() {
            clearTimeout(resolveKycDebounce);
            const resolvedEl = document.getElementById('kyc-account-resolved-name');
            const cardEl = document.getElementById('kyc-account-card');
            const cardNameEl = document.getElementById('kyc-card-acc-name');
            const cardBankEl = document.getElementById('kyc-card-acc-bank');
            const accountInput = document.getElementById('kyc-account-input');
            const bankSelect = document.getElementById('kyc-bank-select');
            const accountNumber = (accountInput?.value || '').trim();
            const bankVal = bankSelect?.value || '';
            const [bankCode, bankName] = bankVal.split('|');

            if (!resolvedEl) return;
            if (accountNumber.length < 10) {
                resolvedEl.textContent = '';
                if (cardEl) cardEl.classList.add('hidden');
                return;
            }

            // Step 1: Instant CBN NUBAN Checksum Validation (100% Free)
            const isValidNuban = validateCBNNuban(bankCode, accountNumber);
            if (!isValidNuban) {
                if (cardEl) cardEl.classList.add('hidden');
                resolvedEl.textContent = `❌ Invalid NUBAN Checksum: Not a valid ${bankName} account number`;
                resolvedEl.className = 'mt-1 text-[11px] font-bold text-rose-400 min-h-4';
                return;
            }

            resolvedEl.textContent = `⏳ Valid CBN NUBAN checksum. Fetching ${bankName} account name…`;
            resolvedEl.className = 'mt-1 text-[11px] font-semibold text-cyan-300 min-h-4';

            resolveKycDebounce = setTimeout(async () => {
                const client = getSupabaseAuthClient();
                if (client) {
                    try {
                        const { data, error } = await client.functions.invoke('verify-identity', {
                            body: { action: 'resolve_account', bankCode, accountNumber }
                        });
                        if (!error && data?.success && data.account_name) {
                            resolvedEl.textContent = '';
                            if (cardEl && cardNameEl && cardBankEl) {
                                cardNameEl.textContent = data.account_name;
                                cardBankEl.textContent = `${bankName} · ${accountNumber}`;
                                cardEl.classList.remove('hidden');
                            }
                            const nameInput = document.getElementById('kyc-name-input');
                            if (nameInput && !nameInput.value) {
                                nameInput.value = data.account_name;
                            }
                            return;
                        } else if (error || (data && !data.success)) {
                            if (cardEl) cardEl.classList.add('hidden');
                            resolvedEl.textContent = `❌ Paystack: Account not found at ${bankName}. Please check the number.`;
                            resolvedEl.className = 'mt-1 text-[11px] font-bold text-rose-400 min-h-4';
                            return;
                        }
                    } catch (e) {}
                }
                // Fallback valid display
                if (cardEl && cardNameEl && cardBankEl) {
                    const fallbackName = document.getElementById('kyc-name-input')?.value || 'Registered Account Holder';
                    cardNameEl.textContent = fallbackName;
                    cardBankEl.textContent = `${bankName} · ${accountNumber}`;
                    cardEl.classList.remove('hidden');
                    resolvedEl.textContent = '';
                }
            }, 400);
        }

        async function handleKycSubmit(event) {
            event.preventDefault();
            const statusEl = document.getElementById('kyc-status-msg');
            function setKycMsg(text, isErr) {
                if (statusEl) {
                    statusEl.textContent = text;
                    statusEl.style.color = isErr ? '#f87171' : '#86efac';
                }
            }
            if (activeUser.isGuest) {
                setKycMsg('Please log in with a registered account to complete KYC verification.', true);
                return;
            }

            const numInput = document.getElementById('kyc-number-input');
            const bankSelect = document.getElementById('kyc-bank-select');
            const accountInput = document.getElementById('kyc-account-input');
            const nameInput = document.getElementById('kyc-name-input');
            const dobInput = document.getElementById('kyc-dob-input');
            const submitBtn = document.getElementById('btn-submit-kyc');

            const idNumber = (numInput?.value || '').trim();
            const bankVal = bankSelect?.value || '';
            const [bankCode, bankName] = bankVal.split('|');
            const accountNumber = (accountInput?.value || '').trim();
            const rawLegalName = (nameInput?.value || '').trim();
            const dob = dobInput?.value;

            // 1. Strict BVN / NIN anti-fake validation
            const idCheck = validateBvnOrNin(idNumber, currentKycType);
            if (!idCheck.valid) {
                setKycMsg(`❌ ${idCheck.error}`, true);
                return;
            }

            // 2. Bank Selection check
            if (!bankCode || !bankName) {
                setKycMsg('❌ Please select your Nigerian payout bank.', true);
                return;
            }

            // 3. Central Bank of Nigeria NUBAN check digit algorithm
            if (!/^\d{10}$/.test(accountNumber)) {
                setKycMsg('❌ Please enter a valid 10-digit Nigerian NUBAN account number.', true);
                return;
            }
            const isNubanValid = validateCBNNuban(bankCode, accountNumber);
            if (!isNubanValid) {
                setKycMsg(`❌ Fake / Invalid Account: The number "${accountNumber}" does not pass Central Bank of Nigeria (CBN) NUBAN checksum for ${bankName}.`, true);
                return;
            }

            // 4. Full Legal Name validation
            const nameCheck = validateLegalName(rawLegalName);
            if (!nameCheck.valid) {
                setKycMsg(`❌ ${nameCheck.error}`, true);
                return;
            }
            const legalName = nameCheck.cleanName;

            // 5. Date of Birth & 18+ Age check
            const dobCheck = validateDateOfBirth(dob);
            if (!dobCheck.valid) {
                setKycMsg(`❌ ${dobCheck.error}`, true);
                return;
            }

            // Disable submit button during verification check
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-xs"></i><span>VERIFYING WITH NIBSS & BANK…</span>';
            }
            setKycMsg('🔍 Verifying details against Nigerian banking records (₦0.00 zero cost)…', false);

            let verifiedAccountHolderName = legalName;

            // 6. Live Paystack Bank Account Resolution
            const client = getSupabaseAuthClient();
            if (client) {
                try {
                    const { data, error } = await client.functions.invoke('verify-identity', {
                        body: { action: 'resolve_account', bankCode, accountNumber }
                    });
                    if (data?.success && data.account_name) {
                        verifiedAccountHolderName = data.account_name;
                        // Compare entered legalName with resolved account holder name
                        const userParts = legalName.toLowerCase().split(/\s+/);
                        const bankParts = data.account_name.toLowerCase().split(/\s+/);
                        const hasMatch = userParts.some(p => p.length >= 3 && bankParts.some(bp => bp.includes(p) || p.includes(bp)));
                        if (!hasMatch) {
                            if (submitBtn) {
                                submitBtn.disabled = false;
                                submitBtn.innerHTML = '<i class="fa-solid fa-shield-halved text-xs"></i><span>VERIFY REAL IDENTITY</span>';
                            }
                            setKycMsg(`❌ Identity Mismatch: Name "${legalName}" does not match registered bank account name ("${data.account_name}"). Please use your real ID and bank details.`, true);
                            return;
                        }
                    } else if (error && error.message && !error.message.includes('FetchError')) {
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = '<i class="fa-solid fa-shield-halved text-xs"></i><span>VERIFY REAL IDENTITY</span>';
                        }
                        setKycMsg(`❌ Verification Failed: Could not resolve account at ${bankName}. Please enter your genuine 10-digit account number.`, true);
                        return;
                    }
                } catch (e) {
                    console.warn('Live bank lookup note:', e);
                }
            }

            const maskedId = idNumber.slice(0, 3) + '******' + idNumber.slice(-2);
            activeUser.isVerified = true;
            activeUser.kyc = {
                type: currentKycType,
                idMasked: maskedId,
                name: legalName,
                bankCode: bankCode,
                bankName: bankName,
                accountNumber: accountNumber,
                accountName: verifiedAccountHolderName,
                dob: dob,
                verifiedAt: new Date().toISOString()
            };

            // Save locally
            saveCurrentUserSession(activeUser);
            const users = readUsers();
            const uIdx = users.findIndex(u => u.email.toLowerCase() === activeUser.email.toLowerCase());
            if (uIdx >= 0) {
                users[uIdx].isVerified = true;
                users[uIdx].kyc = activeUser.kyc;
                writeUsers(users);
            }

            // Persist to Supabase profiles
            if (client && activeUser.id) {
                try {
                    await client.from('profiles').update({
                        is_verified: true,
                        kyc_type: currentKycType,
                        kyc_id_masked: maskedId,
                        legal_name: legalName,
                        bank_code: bankCode,
                        bank_name: bankName,
                        account_number: accountNumber
                    }).eq('id', activeUser.id);
                } catch (e) {
                    console.warn('Supabase KYC update warning:', e);
                }
            }

            updateKycUI();
            setKycMsg(`✅ Verification successful! Real identity verified for ${legalName}. Instant withdrawals unlocked.`, false);

            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fa-solid fa-circle-check text-xs"></i><span>IDENTITY VERIFIED</span>';
            }

            setTimeout(() => {
                closeKycModal();
                if (kycTriggerOrigin === 'withdrawal') {
                    openWithdrawModal();
                }
            }, 1400);
        }

        let resolveAccountDebounce = null;
        async function resolveWithdrawAccountName() {
            clearTimeout(resolveAccountDebounce);
            const resolvedEl = document.getElementById('withdraw-resolved-name');
            const cardEl = document.getElementById('withdraw-account-card');
            const cardNameEl = document.getElementById('withdraw-card-acc-name');
            const cardBankEl = document.getElementById('withdraw-card-acc-bank');
            const accountInput = document.getElementById('withdraw-account');
            const bankSelect = document.getElementById('withdraw-bank');
            const accountNumber = (accountInput?.value || '').trim();
            const bankVal = bankSelect?.value || '';
            const [bankCode, bankName] = bankVal.split('|');

            if (!resolvedEl) return;
            if (accountNumber.length < 10) {
                resolvedEl.textContent = '';
                if (cardEl) cardEl.classList.add('hidden');
                return;
            }

            // Validate CBN NUBAN
            if (!validateCBNNuban(bankCode, accountNumber)) {
                if (cardEl) cardEl.classList.add('hidden');
                resolvedEl.textContent = `❌ Invalid NUBAN Checksum for ${bankName}`;
                resolvedEl.className = 'mt-1 text-[11px] font-bold text-rose-400 min-h-4';
                return;
            }

            resolvedEl.textContent = 'Verifying bank account with Paystack…';
            resolvedEl.className = 'mt-1 text-[11px] font-semibold text-slate-400 min-h-4';

            resolveAccountDebounce = setTimeout(async () => {
                const client = getSupabaseAuthClient();
                if (client) {
                    try {
                        const { data, error } = await client.functions.invoke('verify-identity', {
                            body: { action: 'resolve_account', bankCode, accountNumber }
                        });
                        if (!error && data?.success && data.account_name) {
                            resolvedEl.textContent = '';
                            if (cardEl && cardNameEl && cardBankEl) {
                                cardNameEl.textContent = data.account_name;
                                cardBankEl.textContent = `${bankName} · ${accountNumber}`;
                                cardEl.classList.remove('hidden');
                            }
                            return;
                        } else if (error || (data && !data.success)) {
                            if (cardEl) cardEl.classList.add('hidden');
                            resolvedEl.textContent = `❌ Account not found at ${bankName}`;
                            resolvedEl.className = 'mt-1 text-[11px] font-bold text-rose-400 min-h-4';
                            return;
                        }
                    } catch (e) {}
                }
                // Fallback display
                if (cardEl && cardNameEl && cardBankEl) {
                    cardNameEl.textContent = activeUser.kyc?.name || activeUser.name || 'Verified Recipient';
                    cardBankEl.textContent = `${bankName} · ${accountNumber}`;
                    cardEl.classList.remove('hidden');
                    resolvedEl.textContent = '';
                }
            }, 400);
        }

        function openWithdrawModal() {
            if (activeUser.isGuest) {
                alert('Please log in to your account to withdraw funds.');
                return;
            }
            if (!activeUser.isVerified) {
                openKycModal('withdrawal');
                return;
            }
            const maxEl = document.getElementById('withdraw-max-balance');
            if (maxEl) maxEl.textContent = `₦${userWalletBalance.toLocaleString()}`;
            const amountInput = document.getElementById('withdraw-amount');
            if (amountInput) amountInput.value = Math.min(userWalletBalance, 5000);

            // Prefill with verified KYC bank details
            const bankSelect = document.getElementById('withdraw-bank');
            const accountInput = document.getElementById('withdraw-account');
            const cardEl = document.getElementById('withdraw-account-card');
            const cardNameEl = document.getElementById('withdraw-card-acc-name');
            const cardBankEl = document.getElementById('withdraw-card-acc-bank');
            const resolvedEl = document.getElementById('withdraw-resolved-name');

            if (activeUser.kyc?.bankCode && activeUser.kyc?.accountNumber) {
                if (bankSelect && activeUser.kyc.bankCode) {
                    const matchOpt = Array.from(bankSelect.options).find(o => o.value.startsWith(activeUser.kyc.bankCode));
                    if (matchOpt) bankSelect.value = matchOpt.value;
                }
                if (accountInput) {
                    accountInput.value = activeUser.kyc.accountNumber;
                }
                if (cardEl && cardNameEl && cardBankEl) {
                    cardNameEl.textContent = activeUser.kyc.accountName || activeUser.kyc.name || 'Verified Recipient';
                    cardBankEl.textContent = `${activeUser.kyc.bankName || 'Nigerian Bank'} · ${activeUser.kyc.accountNumber}`;
                    cardEl.classList.remove('hidden');
                }
                if (resolvedEl) resolvedEl.textContent = '';
            } else {
                if (cardEl) cardEl.classList.add('hidden');
                if (resolvedEl) resolvedEl.textContent = '';
            }

            const msgEl = document.getElementById('withdraw-status-msg');
            if (msgEl) msgEl.textContent = '';
            document.getElementById('withdraw-modal').classList.remove('hidden');
        }

        function closeWithdrawModal() {
            document.getElementById('withdraw-modal').classList.add('hidden');
        }

        async function submitWithdrawal() {
            const msgEl = document.getElementById('withdraw-status-msg');
            function setWdMsg(text, isErr) {
                if (msgEl) { msgEl.textContent = text; msgEl.style.color = isErr ? '#f87171' : '#86efac'; }
            }
            if (activeUser.isGuest) { setWdMsg('Log in to withdraw funds.', true); return; }
            if (!activeUser.isVerified) {
                setWdMsg('Identity verification (BVN/NIN) is required before withdrawing.', true);
                openKycModal('withdrawal');
                return;
            }
            const bankSelect = document.getElementById('withdraw-bank');
            const accountInput = document.getElementById('withdraw-account');
            const amountInput = document.getElementById('withdraw-amount');
            const bankVal = bankSelect?.value || '';
            const accountNumber = (accountInput?.value || '').trim();
            const amount = Number(amountInput?.value || 0);
            const [bankCode, bankName] = bankVal.split('|');
            if (!bankCode || !bankName) { setWdMsg('Select your bank.', true); return; }
            if (!/^\d{10}$/.test(accountNumber)) { setWdMsg('Enter a valid 10-digit account number.', true); return; }

            // Validate CBN NUBAN
            if (!validateCBNNuban(bankCode, accountNumber)) {
                setWdMsg(`❌ Invalid account number: Failed Central Bank of Nigeria NUBAN checksum for ${bankName}.`, true);
                return;
            }

            if (amount < 1000) { setWdMsg('Minimum withdrawal is ₦1,000.', true); return; }
            if (amount > userWalletBalance) { setWdMsg('Amount exceeds your available balance.', true); return; }

            // Deduct balance immediately (hold)
            userWalletBalance -= amount;
            updateWalletDisplay();

            // Save pending withdrawal locally
            const withdrawals = JSON.parse(localStorage.getItem(STORAGE_KEYS.withdrawals) || '[]');
            const record = { bankName, bankCode, accountNumber, amount, status: 'Pending', time: new Date().toISOString() };
            withdrawals.unshift(record);
            localStorage.setItem(STORAGE_KEYS.withdrawals, JSON.stringify(withdrawals.slice(0, 50)));
            const transactions = JSON.parse(localStorage.getItem(STORAGE_KEYS.transactions) || '[]');
            transactions.unshift({ title: `Withdrawal — ${bankName}`, type: 'withdrawal', amount, detail: new Date().toLocaleString() });
            localStorage.setItem(STORAGE_KEYS.transactions, JSON.stringify(transactions.slice(0, 100)));

            setWdMsg('Withdrawal request submitted. Processing…');

            // Call Supabase for server-side payout
            const client = getSupabaseAuthClient();
            if (client && activeUser.id) {
                try {
                    client.from('profiles').update({ wallet_balance: userWalletBalance }).eq('id', activeUser.id).then();
                    await client.from('transactions').insert([{
                        user_id: activeUser.id,
                        type: 'withdrawal',
                        amount,
                        status: 'pending',
                        detail: JSON.stringify({ bankCode, bankName, accountNumber, verified_name: activeUser.kyc?.name || '' })
                    }]);
                } catch (e) { /* server will handle async */ }
            }
            setWdMsg(`₦${amount.toLocaleString()} withdrawal request received. Pays out to ${activeUser.kyc?.name || 'verified account'} within 24h.`);
            setTimeout(() => closeWithdrawModal(), 2500);
        }

        renderWalletTransactions();

        // ── GAME LAUNCH FUNCTIONS ─────────────────────────────────────────────

        function playPracticeMatch() {
            closeGameOptions();
            launchGameModule('practice');
        }

        function selectStakeAmount(amount) {
            selectedStakeAmount = Number(amount);
            const payout = Math.floor(selectedStakeAmount * 2 * (1 - RAKE_PERCENT / 100));
            // Update preset buttons
            document.querySelectorAll('.stake-btn').forEach(btn => {
                const isActive = Number(btn.dataset.stake) === selectedStakeAmount;
                btn.classList.toggle('active', isActive);
                btn.classList.toggle('border-amber-400', isActive);
                btn.classList.toggle('bg-amber-400/20', isActive);
                btn.classList.toggle('text-amber-200', isActive);
                btn.classList.toggle('border-white/10', !isActive);
                btn.classList.toggle('bg-darkBg', !isActive);
            });
            // Update display
            const dispAmt = document.getElementById('stake-display-amount');
            const dispPayout = document.getElementById('stake-payout-amount');
            const dispBtn = document.getElementById('stake-btn-amount');
            const custInput = document.getElementById('custom-stake-input');
            if (dispAmt) dispAmt.textContent = `₦${selectedStakeAmount.toLocaleString()}`;
            if (dispPayout) dispPayout.textContent = `₦${payout.toLocaleString()}`;
            if (dispBtn) dispBtn.textContent = selectedStakeAmount.toLocaleString();
            if (custInput) custInput.value = selectedStakeAmount;
        }

        function onCustomStakeChange(value) {
            const amount = Number(value) || 0;
            if (amount < 200) return;
            selectedStakeAmount = amount;
            const payout = Math.floor(selectedStakeAmount * 2 * (1 - RAKE_PERCENT / 100));
            // Deactivate all preset buttons
            document.querySelectorAll('.stake-btn').forEach(btn => {
                btn.classList.remove('active', 'border-amber-400', 'bg-amber-400/20', 'text-amber-200');
                btn.classList.add('border-white/10', 'bg-darkBg');
            });
            const dispAmt = document.getElementById('stake-display-amount');
            const dispPayout = document.getElementById('stake-payout-amount');
            const dispBtn = document.getElementById('stake-btn-amount');
            if (dispAmt) dispAmt.textContent = `₦${selectedStakeAmount.toLocaleString()}`;
            if (dispPayout) dispPayout.textContent = `₦${payout.toLocaleString()}`;
            if (dispBtn) dispBtn.textContent = selectedStakeAmount.toLocaleString();
        }

        async function startStakeChallenge() {
            const errEl = document.getElementById('stake-error-status');
            function setStakeErr(msg) { if (errEl) errEl.textContent = msg; }
            setStakeErr('');

            if (activeUser.isGuest) { setStakeErr('You must be logged in to stake real money.'); return; }
            if (selectedStakeAmount < 200) { setStakeErr('Minimum stake is ₦200.'); return; }
            if (selectedStakeAmount > userWalletBalance) {
                setStakeErr(`Insufficient balance. You have ₦${userWalletBalance.toLocaleString()}.`); return;
            }

            const payout = Math.floor(selectedStakeAmount * 2 * (1 - RAKE_PERCENT / 100));
            const challengeId = 'CHLG-' + Date.now() + '-' + Math.random().toString(36).slice(2, 6).toUpperCase();

            // Deduct stake immediately
            userWalletBalance -= selectedStakeAmount;
            updateWalletDisplay();

            activeStakeChallenge = {
                id: challengeId,
                gameId: selectedGameId,
                gameTitle: selectedGameTitle,
                stake: selectedStakeAmount,
                payout,
                status: 'playing'
            };

            // Persist to Supabase
            const client = getSupabaseAuthClient();
            if (client && activeUser.id) {
                try {
                    client.from('profiles').update({ wallet_balance: userWalletBalance }).eq('id', activeUser.id).then();
                    const { data } = await client.from('stake_challenges').insert([{
                        id: challengeId,
                        user_id: activeUser.id,
                        game_id: selectedGameId,
                        stake: selectedStakeAmount,
                        payout,
                        score: 0,
                        status: 'playing'
                    }]).select().maybeSingle();
                    if (data) activeStakeChallenge.id = data.id;
                } catch (e) { console.warn('Supabase stake challenge insert failed:', e); }
            }

            // Record transaction
            const transactions = JSON.parse(localStorage.getItem(STORAGE_KEYS.transactions) || '[]');
            transactions.unshift({ title: `1v1 Stake – ${selectedGameTitle}`, type: 'stake', amount: selectedStakeAmount, detail: new Date().toLocaleString(), reference: challengeId });
            localStorage.setItem(STORAGE_KEYS.transactions, JSON.stringify(transactions.slice(0, 100)));

            closeGameOptions();
            // Launch the game in stake mode
            launchGameModule('stake');
        }

        function renderActiveChallenges() {
            const container = document.getElementById('home-active-challenges');
            if (!container) return;
            // Will be populated from Supabase or local state
            const client = getSupabaseAuthClient();
            if (!client || !activeUser.id) {
                container.innerHTML = '<p class="text-xs text-slate-500">Log in to see your active 1v1 challenges.</p>';
                return;
            }
            client.from('stake_challenges')
                .select('*')
                .eq('user_id', activeUser.id)
                .in('status', ['playing', 'queued', 'matched'])
                .order('created_at', { ascending: false })
                .limit(5)
                .then(({ data }) => {
                    if (!data || !data.length) {
                        container.innerHTML = '<p class="text-xs text-slate-500">No active challenges. Pick a game and stake to start.</p>';
                        return;
                    }
                    container.innerHTML = data.map(ch => {
                        const statusColor = ch.status === 'queued' ? 'text-amber-300' : ch.status === 'matched' ? 'text-accentGreen' : 'text-slate-400';
                        return `<div class="flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-cardBg px-4 py-3">
                            <div class="min-w-0"><p class="truncate text-xs font-bold">${ch.game_id}</p><p class="mt-0.5 text-[10px] text-slate-400">₦${Number(ch.stake).toLocaleString()} stake</p></div>
                            <span class="shrink-0 text-[10px] font-bold ${statusColor}">${ch.status.toUpperCase()}</span>
                        </div>`;
                    }).join('');
                })
                .catch(() => { container.innerHTML = ''; });
        }

        function closeMatchmakingModal() {
            document.getElementById('matchmaking-modal').classList.add('hidden');
        }

        function closeMatchmakingAndGoGames() {
            closeMatchmakingModal();
            switchTab('games');
        }

        async function cancelActiveChallenge() {
            if (!activeStakeChallenge) { closeMatchmakingModal(); return; }
            const { id, stake, status } = activeStakeChallenge;
            if (status === 'matched') {
                // Already matched — cannot cancel
                const titleEl = document.getElementById('matchmaking-status-title');
                const subEl = document.getElementById('matchmaking-status-sub');
                if (titleEl) titleEl.textContent = 'Match already settled';
                if (subEl) subEl.textContent = 'This challenge has been matched and cannot be cancelled.';
                return;
            }
            // Refund the stake
            userWalletBalance += stake;
            updateWalletDisplay();

            const transactions = JSON.parse(localStorage.getItem(STORAGE_KEYS.transactions) || '[]');
            transactions.unshift({ title: 'Stake Refund (Cancelled)', type: 'bonus', amount: stake, detail: new Date().toLocaleString() });
            localStorage.setItem(STORAGE_KEYS.transactions, JSON.stringify(transactions.slice(0, 100)));

            const client = getSupabaseAuthClient();
            if (client && activeUser.id) {
                try {
                    client.from('profiles').update({ wallet_balance: userWalletBalance }).eq('id', activeUser.id).then();
                    await client.from('stake_challenges').update({ status: 'cancelled' }).eq('id', id).eq('user_id', activeUser.id);
                } catch (e) {}
            }
            activeStakeChallenge = null;
            closeMatchmakingModal();
        }



        function launchGame(title, url, mode) {
            if (!url) {
                alert('This game is not available yet.');
                return;
            }

            document.getElementById('oddzone-game-frame').classList.add('hidden');
            document.getElementById('game-iframe').classList.remove('hidden');
            document.getElementById('game-scoreboard').classList.add('hidden');
            document.getElementById('arena-game-title').innerText = title;
            document.getElementById('arena-mode-badge').innerText = mode === 'free' ? 'Free Play' : '1v1 Match';
            document.getElementById('game-iframe').src = url;
            document.getElementById('game-arena-modal').classList.remove('hidden');
        }

        function openGameOptions(gameId) {
            const game = GAME_CATALOG.find(candidate => candidate.id === gameId);
            if (!game) return;
            selectedGameId = game.id;
            selectedGameTitle = game.title;
            selectedGameUrl = game.url || game.path;
            document.getElementById('game-options-title').innerText = game.title;
            // Reset stake UI to default
            selectedStakeAmount = 1000;
            selectStakeAmount(1000);
            const errEl = document.getElementById('stake-error-status');
            if (errEl) errEl.textContent = '';
            document.getElementById('game-options-modal').classList.remove('hidden');
        }

        function closeGameOptions() {
            document.getElementById('game-options-modal').classList.add('hidden');
        }

        function playSelectedGame() {
            closeGameOptions();
            launchGameModule('free');
        }

        function playOddZoneScorePractice() {
            closeGameOptions();
            launchGameModule('practice');
        }

        function launchGameModule(mode) {
            const game = GAME_CATALOG.find(candidate => candidate.id === selectedGameId);
            if (!game) return;

            // External games open directly in the iframe (no timed match wrapper)
            if (game.isExternal) {
                document.getElementById('arena-game-title').innerText = game.title;
                document.getElementById('arena-mode-badge').innerText = mode === 'practice' ? 'Practice · External' : 'Free Play';
                document.getElementById('oddzone-game-frame').classList.add('hidden');
                document.getElementById('game-iframe').classList.remove('hidden');
                document.getElementById('game-scoreboard').classList.add('hidden');
                document.getElementById('game-iframe').src = game.url;
                document.getElementById('game-arena-modal').classList.remove('hidden');
                return;
            }

            const launchToken = ++gameLaunchToken;
            clearInterval(matchTimerInterval);
            clearTimeout(matchFinishFallback);
            activeTimedMatch = null;
            const isTimedMode = mode === 'practice' || mode === 'stake';
            pendingTimedMatchMode = isTimedMode ? mode : null;
            const badgeLabel = mode === 'practice' ? 'Preparing 2-Minute Match' : mode === 'stake' ? 'Loading 1v1 Stake Run' : 'Free Play';
            document.getElementById('arena-game-title').innerText = game.title;
            document.getElementById('arena-mode-badge').innerText = badgeLabel;
            document.getElementById('external-game-container').classList.remove('hidden');
            document.getElementById('game-iframe').classList.add('hidden');
            document.getElementById('oddzone-game-frame').classList.remove('hidden');
            document.getElementById('oddzone-game-frame').removeAttribute('srcdoc');
            const frame = document.getElementById('oddzone-game-frame');
            frame.onload = async () => {
                let href = '';
                try { href = frame.contentWindow?.location?.href || ''; } catch (e) {}
                if (gameLaunchToken !== launchToken || selectedGameId !== game.id || href === 'about:blank') return;
                if (isTimedMode) {
                    try {
                        const startGame = frame.contentWindow?.__oddzoneStart;
                        if (typeof startGame === 'function') await startGame.call(frame.contentWindow);
                        if (gameLaunchToken === launchToken && selectedGameId === game.id) startTimedMatch(mode, null, game.id);
                    } catch (error) {
                        document.getElementById('arena-mode-badge').innerText = 'Game could not start';
                        console.error(`Unable to start ${game.title}`, error);
                    }
                } else {
                    document.getElementById('arena-mode-badge').innerText = 'Free Play';
                }
            };
            frame.src = `${encodeURI(game.path)}?oddzoneRun=${Date.now()}`;
            document.getElementById('game-arena-modal').classList.remove('hidden');
            document.getElementById('game-scoreboard').classList.toggle('hidden', !isTimedMode);
        }

        function savePracticeScore(result) {
            const savedResult = {
                game: GAME_CATALOG.find(game => game.id === result.gameId)?.title || 'Arcade Game',
                gameId: result.gameId,
                mode: result.mode,
                playerName: activeUser.name,
                playerEmail: activeUser.email,
                score: result.score,
                durationSeconds: result.durationSeconds,
                completedAt: result.completedAt
            };
            const scores = readPracticeScores();
            scores.unshift(savedResult);
            localStorage.setItem('oddzone-practice-scores', JSON.stringify(scores.slice(0, 50)));
            document.getElementById('arena-mode-badge').innerText = `${savedResult.game} · ${result.score.toLocaleString()} pts`;
            renderDashboardScores();
            renderLocalScoreLeaderboard();
            renderProfileStats();
        }

        function renderProfileStats() {
            const trialsNode = document.getElementById('profile-trials');
            const bestNode = document.getElementById('profile-best');
            if (!trialsNode || !bestNode) return;
            const scores = readPracticeScores().filter(result =>
                !result.playerEmail || result.playerEmail.toLowerCase() === (activeUser.email || '').toLowerCase()
            );
            const best = scores.reduce((highest, result) => Math.max(highest, Number(result.score || 0)), 0);
            trialsNode.textContent = String(scores.length);
            bestNode.textContent = `${best.toLocaleString()} pts`;
        }

        function readActiveGameScore() {
            const gameFrame = document.getElementById('oddzone-game-frame');
            try {
                const scoreReader = gameFrame.contentWindow?.__oddzoneReadScore;
                const score = typeof scoreReader === 'function' ? Number(scoreReader.call(gameFrame.contentWindow)) : 0;
                return Number.isFinite(score) ? Math.max(0, Math.floor(score)) : 0;
            } catch (error) {
                return activeGameScore;
            }
        }

        function startTimedMatch(mode, matchId = null, gameId = selectedGameId) {
            clearInterval(matchTimerInterval);
            clearTimeout(matchFinishFallback);
            pendingTimedMatchMode = null;
            activeGameScore = readActiveGameScore();
            activeTimedMatch = {
                mode,
                matchId,
                gameId,
                deadline: performance.now() + MATCH_DURATION_MS,
                ending: false,
                completed: false
            };
            document.getElementById('scoreboard-mode').innerText = '2-Minute Match';
            document.getElementById('scoreboard-player').innerText = activeUser.name;
            document.getElementById('match-score').innerText = '0';
            document.getElementById('match-timer').innerText = '02:00';
            document.getElementById('game-scoreboard').classList.remove('hidden');
            updateMatchTimer();
            matchTimerInterval = setInterval(updateMatchTimer, 100);
        }

        function updateMatchTimer() {
            if (!activeTimedMatch || activeTimedMatch.ending) return;
            activeGameScore = readActiveGameScore();
            document.getElementById('match-score').innerText = activeGameScore.toLocaleString();
            const remainingMs = Math.max(0, activeTimedMatch.deadline - performance.now());
            const remainingSeconds = Math.ceil(remainingMs / 1000);
            const minutes = Math.floor(remainingSeconds / 60).toString().padStart(2, '0');
            const seconds = (remainingSeconds % 60).toString().padStart(2, '0');
            document.getElementById('match-timer').innerText = `${minutes}:${seconds}`;
            if (remainingMs === 0) endTimedMatch();
        }

        function endTimedMatch() {
            if (!activeTimedMatch || activeTimedMatch.ending) return;
            activeTimedMatch.ending = true;
            document.getElementById('match-timer').innerText = '00:00';
            document.getElementById('arena-mode-badge').innerText = 'Finalizing score...';
            const gameFrame = document.getElementById('oddzone-game-frame');
            try {
                gameFrame.contentWindow.__oddzoneEnd?.();
                activeGameScore = readActiveGameScore();
            } catch (error) {
                console.error('Unable to stop the active game cleanly', error);
            }
            finishTimedMatch(activeGameScore);
        }

        async function finishTimedMatch(score) {
            if (!activeTimedMatch || activeTimedMatch.completed) return;
            activeTimedMatch.completed = true;
            clearInterval(matchTimerInterval);
            clearTimeout(matchFinishFallback);
            const completedAt = new Date().toISOString();
            const matchMode = activeTimedMatch.mode;
            const matchGameId = activeTimedMatch.gameId;
            activeTimedMatch = null;

            if (matchMode === 'stake' && activeStakeChallenge) {
                // Submit score for stake challenge
                const challenge = activeStakeChallenge;
                challenge.score = score;
                challenge.status = 'queued';

                // Close game, open matchmaking modal
                closeGameArena();
                const mm = document.getElementById('matchmaking-modal');
                if (mm) mm.classList.remove('hidden');
                const titleEl = document.getElementById('matchmaking-status-title');
                const subEl = document.getElementById('matchmaking-status-sub');
                const cancelBtn = document.getElementById('matchmaking-cancel-btn');
                const doneBtn = document.getElementById('matchmaking-done-btn');
                const scoreYou = document.getElementById('match-score-you');
                const breakdown = document.getElementById('matchmaking-score-breakdown');
                if (titleEl) titleEl.textContent = 'Searching for Opponent…';
                if (subEl) subEl.textContent = `Your score: ${score.toLocaleString()} pts. Looking for another player at ₦${challenge.stake.toLocaleString()}…`;
                if (scoreYou) scoreYou.textContent = score.toLocaleString();
                if (breakdown) breakdown.classList.remove('hidden');
                if (cancelBtn) cancelBtn.classList.remove('hidden');
                if (doneBtn) doneBtn.classList.add('hidden');

                // Submit to Supabase and poll for a match
                const client = getSupabaseAuthClient();
                if (client && activeUser.id) {
                    try {
                        await client.from('stake_challenges').update({
                            score,
                            status: 'queued'
                        }).eq('id', challenge.id).eq('user_id', activeUser.id);

                        // Try to find an opponent already queued for the same game + stake
                        const { data: opponents } = await client.from('stake_challenges')
                            .select('*')
                            .eq('game_id', challenge.gameId)
                            .eq('stake', challenge.stake)
                            .eq('status', 'queued')
                            .neq('user_id', activeUser.id)
                            .order('created_at', { ascending: true })
                            .limit(1);

                        if (opponents && opponents.length > 0) {
                            const opp = opponents[0];
                            // Match found — determine winner
                            const iWin = score > opp.score;
                            const isTie = score === opp.score;
                            const winnerId = isTie ? null : (iWin ? activeUser.id : opp.user_id);

                            // Update both challenges as matched
                            await client.from('stake_challenges').update({
                                status: 'matched',
                                opponent_id: opp.user_id,
                                winner_id: winnerId
                            }).eq('id', challenge.id);
                            await client.from('stake_challenges').update({
                                status: 'matched',
                                opponent_id: activeUser.id,
                                winner_id: winnerId
                            }).eq('id', opp.id);

                            if (isTie) {
                                // Refund both
                                userWalletBalance += challenge.stake;
                                updateWalletDisplay();
                                if (client && activeUser.id) {
                                    client.from('profiles').update({ wallet_balance: userWalletBalance }).eq('id', activeUser.id).then();
                                }
                                const txs = JSON.parse(localStorage.getItem(STORAGE_KEYS.transactions) || '[]');
                                txs.unshift({ title: 'Tie – Stake Refunded', type: 'bonus', amount: challenge.stake, detail: new Date().toLocaleString() });
                                localStorage.setItem(STORAGE_KEYS.transactions, JSON.stringify(txs.slice(0, 100)));
                                if (titleEl) titleEl.textContent = "It's a Tie!";
                                if (subEl) subEl.textContent = `Both scores were ${score.toLocaleString()} pts. Your ₦${challenge.stake.toLocaleString()} stake has been refunded.`;
                            } else if (iWin) {
                                userWalletBalance += challenge.payout;
                                updateWalletDisplay();
                                if (client && activeUser.id) {
                                    client.from('profiles').update({ wallet_balance: userWalletBalance }).eq('id', activeUser.id).then();
                                }
                                const txs = JSON.parse(localStorage.getItem(STORAGE_KEYS.transactions) || '[]');
                                txs.unshift({ title: `1v1 Win – ${challenge.gameTitle}`, type: 'deposit', amount: challenge.payout, detail: new Date().toLocaleString() });
                                localStorage.setItem(STORAGE_KEYS.transactions, JSON.stringify(txs.slice(0, 100)));
                                if (titleEl) titleEl.textContent = '🏆 You Won!';
                                if (subEl) subEl.textContent = `${score.toLocaleString()} pts vs ${opp.score.toLocaleString()} pts. ₦${challenge.payout.toLocaleString()} added to your wallet!`;
                            } else {
                                if (titleEl) titleEl.textContent = 'You Lost This Round';
                                if (subEl) subEl.textContent = `${score.toLocaleString()} pts vs ${opp.score.toLocaleString()} pts. Better luck next time!`;
                            }

                            const oppLabel = document.getElementById('match-opponent-label');
                            const oppScore = document.getElementById('match-score-opponent');
                            if (oppLabel) oppLabel.textContent = 'Opponent';
                            if (oppScore) oppScore.textContent = opp.score.toLocaleString();
                            if (cancelBtn) cancelBtn.classList.add('hidden');
                            const playMoreBtn = document.getElementById('matchmaking-play-more-btn');
                            if (playMoreBtn) playMoreBtn.classList.remove('hidden');
                            if (doneBtn) doneBtn.classList.remove('hidden');
                            activeStakeChallenge = null;
                        }
                        // If no opponent yet, keep challenge in 'queued' state — player can cancel
                    } catch (e) {
                        console.warn('Stake match submission error:', e);
                        if (subEl) subEl.textContent = 'Score submitted locally. Match will settle once an opponent plays.';
                    }
                }
                renderActiveChallenges();
                renderDashboardScores();
            } else {
                // Practice mode — save score locally
                savePracticeScore({
                    score,
                    gameId: matchGameId,
                    mode: matchMode,
                    durationSeconds: 120,
                    completedAt
                });
            }
        }

        function createSkyPatrolGame() {
            return `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"><style>
                *{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden;background:#07111b;color:#e8f4ff;font-family:system-ui,sans-serif}canvas{display:block;width:100%;height:100%;touch-action:none}.help{position:absolute;left:0;right:0;bottom:16px;text-align:center;color:#b8cada;font-size:12px;text-shadow:0 1px 4px #000;pointer-events:none}
                </style></head><body><canvas id="field" aria-label="Sky Patrol arcade shooter"></canvas><div class="help">Move with A/D or arrow keys · Hold Space to fire · Touch and drag to steer</div><script>
                (()=>{const canvas=document.getElementById('field'),ctx=canvas.getContext('2d');let width=0,height=0,scale=1,score=0,ended=false,shipX=.5,lastShot=0,lastSpawn=0,lastFrame=0;const keys=new Set(),shots=[],targets=[],stars=[];
                function resize(){scale=Math.min(window.devicePixelRatio||1,2);width=innerWidth;height=innerHeight;canvas.width=Math.floor(width*scale);canvas.height=Math.floor(height*scale);ctx.setTransform(scale,0,0,scale,0,0);stars.length=0;for(let index=0;index<70;index++)stars.push({x:Math.random()*width,y:Math.random()*height,size:Math.random()*1.8+.4,speed:Math.random()*24+12})}window.addEventListener('resize',resize);resize();
                function report(){parent.postMessage({type:'oddzone:score',score},'*')}function finish(){if(ended)return;ended=true;parent.postMessage({type:'oddzone:game-complete',score},'*')}
                window.addEventListener('message',event=>{if(event.source===parent&&event.origin===location.origin&&event.data&&event.data.type==='oddzone:end')finish()});window.addEventListener('keydown',event=>{keys.add(event.code);if(['ArrowLeft','ArrowRight','Space'].includes(event.code))event.preventDefault()});window.addEventListener('keyup',event=>keys.delete(event.code));
                canvas.addEventListener('pointerdown',event=>{shipX=Math.max(.05,Math.min(.95,event.clientX/width));keys.add('Space')});canvas.addEventListener('pointermove',event=>{if(event.buttons)shipX=Math.max(.05,Math.min(.95,event.clientX/width))});window.addEventListener('pointerup',()=>keys.delete('Space'));
                function draw(now){if(ended)return;const delta=Math.min((now-lastFrame)/1000,.04);lastFrame=now;ctx.clearRect(0,0,width,height);ctx.fillStyle='#07111b';ctx.fillRect(0,0,width,height);ctx.fillStyle='#b8e8ff';for(const star of stars){star.y=(star.y+star.speed*delta)%height;ctx.globalAlpha=.25+star.size/3;ctx.fillRect(star.x,star.y,star.size,star.size)}ctx.globalAlpha=1;
                if(keys.has('ArrowLeft')||keys.has('KeyA'))shipX=Math.max(.05,shipX-260*delta/width);if(keys.has('ArrowRight')||keys.has('KeyD'))shipX=Math.min(.95,shipX+260*delta/width);
                if(now-lastSpawn>650){lastSpawn=now;targets.push({x:Math.random()*(width-44)+22,y:-28,r:13+Math.random()*9,speed:100+Math.random()*75})}if(keys.has('Space')&&now-lastShot>190){lastShot=now;shots.push({x:shipX*width,y:height-76})}
                ctx.fillStyle='#65f2c2';ctx.beginPath();ctx.moveTo(shipX*width,height-90);ctx.lineTo(shipX*width-18,height-54);ctx.lineTo(shipX*width+18,height-54);ctx.closePath();ctx.fill();ctx.fillStyle='#d4fff1';ctx.fillRect(shipX*width-2,height-56,4,10);
                ctx.fillStyle='#8de7ff';for(let index=shots.length-1;index>=0;index--){const shot=shots[index];shot.y-=430*delta;ctx.fillRect(shot.x-2,shot.y-9,4,12);if(shot.y<-12)shots.splice(index,1)}
                for(let index=targets.length-1;index>=0;index--){const target=targets[index];target.y+=target.speed*delta;ctx.fillStyle='#ff8b72';ctx.beginPath();ctx.arc(target.x,target.y,target.r,0,Math.PI*2);ctx.fill();ctx.fillStyle='#ffd1a8';ctx.beginPath();ctx.arc(target.x-target.r*.25,target.y-target.r*.25,target.r*.25,0,Math.PI*2);ctx.fill();
                for(let shotIndex=shots.length-1;shotIndex>=0;shotIndex--){const shot=shots[shotIndex];if(Math.hypot(target.x-shot.x,target.y-shot.y)<target.r+5){targets.splice(index,1);shots.splice(shotIndex,1);score+=10;report();break}}if(targets[index]&&target.y>height+24)targets.splice(index,1)}requestAnimationFrame(draw)}requestAnimationFrame(draw)})();
                <\/script></body></html>`;
        }

        function requestCashMatch(stake) {
            // Deprecated — stake flow now handled by startStakeChallenge()
            console.warn('requestCashMatch is deprecated. Use startStakeChallenge().');
        }

        function launchMatchmaking(title, url, stake) {
            requestCashMatch(stake);
        }

        function cancelMatchmaking() {
            clearTimeout(window.matchTimeout);
            document.getElementById('matchmaking-modal').classList.add('hidden');
        }

        function closeGameArena() {
            gameLaunchToken++;
            clearInterval(matchTimerInterval);
            clearTimeout(matchFinishFallback);
            activeTimedMatch = null;
            pendingTimedMatchMode = null;
            document.getElementById('game-scoreboard').classList.add('hidden');
            document.getElementById('game-arena-modal').classList.add('hidden');
            document.getElementById('game-iframe').src = '';
            document.getElementById('game-iframe').classList.remove('hidden');
            document.getElementById('oddzone-game-frame').onload = null;
            document.getElementById('oddzone-game-frame').srcdoc = '';
            document.getElementById('oddzone-game-frame').src = '';
            document.getElementById('oddzone-game-frame').classList.add('hidden');
            document.getElementById('external-game-container').classList.remove('hidden');
        }

        async function logoutUser() {
            localStorage.removeItem(STORAGE_KEYS.currentUser);
            const client = getSupabaseAuthClient();
            if (client) {
                try { await client.auth.signOut(); } catch (error) { /* stay on auth screen */ }
            }
            showAuthScreen();
            setAuthStatus('You are signed out.');
        }

        window.addEventListener('message', (event) => {
            if (!event.data || typeof event.data !== 'object') return;
            if (event.data.type === 'oddzone:score' && typeof event.data.score === 'number') {
                activeGameScore = Math.max(activeGameScore, event.data.score);
                const scoreElem = document.getElementById('match-score');
                if (scoreElem) scoreElem.innerText = activeGameScore.toLocaleString();
            } else if (event.data.type === 'oddzone:game-complete' && activeTimedMatch) {
                if (typeof event.data.score === 'number') {
                    activeGameScore = Math.max(activeGameScore, event.data.score);
                }
                endTimedMatch();
            }
        });

        renderGameCards();
        renderLocalScores();
        renderRemoteScores();
        renderLocalScoreLeaderboard();
        renderProfileStats();
        updateKycUI();
        if (typeof window.loadPendingBets === 'function') {
            window.loadPendingBets();
        }
        // ── SETTINGS MODAL ────────────────────────────────────────────────────

        function openSettingsModal() {
            const modal = document.getElementById('settings-modal');
            if (modal) modal.classList.remove('hidden');
            const input = document.getElementById('settings-username-input');
            if (input) input.value = activeUser.name || '';
            const msg = document.getElementById('settings-username-msg');
            if (msg) msg.textContent = '';
            const currentTheme = localStorage.getItem('oddzone-theme') || 'dark';
            updateThemeButtons(currentTheme);
        }

        function closeSettingsModal() {
            document.getElementById('settings-modal')?.classList.add('hidden');
        }

        async function saveSettingsUsername() {
            const input = document.getElementById('settings-username-input');
            const msgEl = document.getElementById('settings-username-msg');
            function setMsg(text, isErr) {
                if (msgEl) { msgEl.textContent = text; msgEl.style.color = isErr ? '#f87171' : '#86efac'; }
            }
            const newName = (input?.value || '').trim();
            if (!newName || newName.length < 3) { setMsg('Username must be at least 3 characters.', true); return; }
            if (newName.length > 20) { setMsg('Username must be 20 characters or less.', true); return; }
            if (!/^[a-zA-Z0-9_.\-]+$/.test(newName)) { setMsg('Only letters, numbers, _, . and - are allowed.', true); return; }
            activeUser.name = newName;
            saveCurrentUserSession(activeUser);
            const users = readUsers();
            const idx = users.findIndex(u => u.email.toLowerCase() === activeUser.email.toLowerCase());
            if (idx >= 0) { users[idx].name = newName; writeUsers(users); }
            const client = getSupabaseAuthClient();
            if (client && activeUser.id) {
                try { await client.from('profiles').update({ username: newName }).eq('id', activeUser.id); }
                catch (e) { console.warn('Username update (Supabase):', e); }
            }
            [document.getElementById('greeting-username'), document.getElementById('nav-greeting-name'), document.getElementById('profile-name')]
                .forEach(el => { if (el) el.textContent = newName; });
            const initials = newName.substring(0, 2).toUpperCase();
            ['user-avatar-initial', 'profile-initial'].forEach(id => { const el = document.getElementById(id); if (el) el.textContent = initials; });
            const friendNameEl = document.getElementById('friend-invite-name');
            if (friendNameEl) friendNameEl.textContent = `${newName}'s invite link`;
            setMsg(`Username updated to "${newName}"!`, false);
        }

        function setAppTheme(theme) {
            localStorage.setItem('oddzone-theme', theme);
            applyTheme(theme);
            updateThemeButtons(theme);
        }

        function applyTheme(theme) {
            let lightStyle = document.getElementById('oddzone-light-style');
            if (theme === 'light') {
                if (!lightStyle) {
                    lightStyle = document.createElement('style');
                    lightStyle.id = 'oddzone-light-style';
                    document.head.appendChild(lightStyle);
                }
                lightStyle.textContent = `
                    body { background-color: #f0f0f6 !important; color: #111827 !important; }
                    #app-container { background: #ffffff !important; }
                    .app-panel { background: #f5f5fb !important; border-color: rgba(0,0,0,0.08) !important; }
                    .app-row { background: #ebebf2 !important; border-color: rgba(0,0,0,0.07) !important; }
                    #top-nav-bar, #bottom-nav { background: rgba(255,255,255,0.97) !important; border-color: rgba(0,0,0,0.08) !important; }
                    .auth-input { background: #f3f3f9 !important; border-color: rgba(0,0,0,0.12) !important; color: #111827 !important; }
                    #main-scroll-area { background: #f0f0f6; }
                    .text-slate-300, .text-slate-400, .text-slate-500 { color: #6b7280 !important; }
                    .nav-item { color: #6b7280 !important; }
                    .nav-item.is-active { color: #7c4dff !important; }
                `;
            } else {
                if (lightStyle) lightStyle.remove();
            }
        }

        function updateThemeButtons(theme) {
            const darkBtn = document.getElementById('theme-dark-btn');
            const lightBtn = document.getElementById('theme-light-btn');
            if (!darkBtn || !lightBtn) return;
            if (theme === 'light') {
                darkBtn.className = 'rounded-xl border border-white/10 bg-white/5 py-2.5 text-xs font-semibold text-slate-600 transition';
                lightBtn.className = 'rounded-xl border border-amber-400 bg-amber-400/20 py-2.5 text-xs font-bold text-amber-600 transition';
            } else {
                darkBtn.className = 'rounded-xl border border-fuchsia-400 bg-fuchsia-400/20 py-2.5 text-xs font-bold text-fuchsia-200 transition';
                lightBtn.className = 'rounded-xl border border-white/10 bg-darkBg py-2.5 text-xs font-semibold text-slate-300 transition';
            }
        }

        // Auto-apply saved theme on load
        (function() {
            const savedTheme = localStorage.getItem('oddzone-theme') || 'dark';
            if (savedTheme === 'light') applyTheme('light');
        })();
    </script>
</body>
</html>